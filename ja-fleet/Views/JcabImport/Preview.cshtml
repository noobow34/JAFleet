@using jafleet.Classes.JcabImport
@model jafleet.Models.JcabImportModel
@{
    Layout = "_LayoutNoHead";
    Model.Title = "Excel取込プレビュー";
    ImportPreview preview = Model.Preview!;

    var typeColors = new Dictionary<JcabRecordType, string>
    {
        { JcabRecordType.New,         "#22c55e" },
        { JcabRecordType.Delete,      "#ef4444" },
        { JcabRecordType.Transfer,    "#3b82f6" },
        { JcabRecordType.Change,      "#f59e0b" },
        { JcabRecordType.Reservation, "#8b5cf6" },
        { JcabRecordType.Cancel,      "#64748b" },
    };

    string Summarize(JcabRecord r) => r.RecordType switch
    {
        JcabRecordType.New => string.Join(" / ", new[] { r.Owner, r.TypeDisplay, r.SerialNumber == null ? null : $"sn {r.SerialNumber}", r.BasePlace }.Where(s => !string.IsNullOrEmpty(s))),
        JcabRecordType.Delete => string.Join(" / ", new[] { r.Owner, r.Reason }.Where(s => !string.IsNullOrEmpty(s))),
        JcabRecordType.Transfer => $"{r.PreviousOwner ?? "―"} → {r.Owner ?? "―"}",
        JcabRecordType.Change => $"{r.ChangeItem}：{r.ChangeOld ?? "―"} → {r.ChangeNew ?? "―"}",
        _ => string.Join(" / ", new[] { r.Owner, r.TypeDisplay, r.ScheduledDate == null ? null : $"納入予定 {r.ScheduledDate}" }.Where(s => !string.IsNullOrEmpty(s))),
    };

    var groups = new (ImportCategory Category, string Id, string Icon, string Title, string Note, bool Collapsed)[]
    {
        (ImportCategory.Ready, "group-ready", "✔", "自動判定OK", "マスタと突き合わせできました", false),
        (ImportCategory.Transfer, "group-transfer", "⇄", "移転登録", "所有者が変わりました。航空会社を変えるかどうか確認してください", false),
        (ImportCategory.NeedsReview, "group-review", "⚠", "要確認", "自動判定できなかったもの、手で移動したもの", true),
        (ImportCategory.OutOfScope, "group-outofscope", "－", "対象外", "取り込まないもの。編集して対象に戻せます", true),
    };
}

@section CssPartial {
<style>
/* ===== Excel取込プレビュー =====
   注意: Bootstrap3 が html{font-size:10px} を設定しているため remは使わずpxで指定すること。 */
.imp-page { padding: 16px 0 90px; }
.imp-page h2 { margin: 0; font-size: 22px; font-weight: 700; color: #1e293b; }

.imp-filebar {
    display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
    background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px;
    padding: 12px 16px; margin: 14px 0 16px;
}
.imp-filename { font-size: 15px; font-weight: 700; color: #1e293b; }
.imp-filemeta { font-size: 13px; color: #64748b; }

.imp-btn {
    display: inline-flex; align-items: center; padding: 7px 16px; border-radius: 6px;
    border: 1px solid #cbd5e1; background: #fff; color: #334155;
    font-size: 14px; font-weight: 600; text-decoration: none; cursor: pointer;
}
.imp-btn:hover { background: #f1f5f9; text-decoration: none; color: #1e293b; }
.imp-btn.primary { background: #0f172a; border-color: #0f172a; color: #fff; }
.imp-btn.primary:hover { background: #1e293b; color: #fff; }

.imp-stats { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
.imp-chip {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 13px 5px 12px; border-radius: 99px;
    font-size: 14px; font-weight: 600; color: #fff;
}
.imp-chip .cnt { background: rgba(0,0,0,.22); border-radius: 99px; padding: 1px 8px; font-size: 13px; }

.imp-warn {
    border: 1px solid #fde68a; background: #fffbeb; border-radius: 10px;
    padding: 12px 16px; margin-bottom: 16px; font-size: 13px; color: #92400e; line-height: 1.7;
}
.imp-saved {
    display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
    border: 1px solid #a7f3d0; background: #ecfdf5; border-radius: 10px;
    padding: 12px 16px; margin-bottom: 16px; font-size: 13px; color: #065f46; font-weight: 600;
}
.imp-saved .imp-saved-note { font-weight: 400; color: #047857; }
.imp-saved .imp-btn { margin-left: auto; }
.imp-saved .imp-btn + .imp-btn { margin-left: 0; }

/* 検索条件の作成 */
.imp-sc {
    border: 1px solid #bfdbfe; background: #eff6ff; border-radius: 10px;
    padding: 12px 16px; margin-bottom: 16px;
}
.imp-sc-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
.imp-sc-title { font-size: 14px; font-weight: 700; color: #1e40af; }
.imp-sc-name { font-size: 14px; font-weight: 700; color: #0f172a; }
.imp-sc-count { font-size: 13px; color: #1d4ed8; }
.imp-sc form { margin: 0; }
.imp-sc-regs {
    margin-top: 8px; font-family: monospace; font-size: 12px; color: #475569;
    line-height: 1.8; word-break: break-all;
}

.imp-group { margin-bottom: 26px; }
.imp-group-head { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; flex-wrap: wrap; }
.imp-group-title { font-size: 16px; font-weight: 700; color: #334155; }
.imp-group-note { font-size: 13px; color: #94a3b8; }
.imp-group-tools { margin-left: auto; display: flex; gap: 8px; }

.imp-item {
    border: 1px solid #e2e8f0; border-radius: 10px; background: #fff;
    padding: 12px 16px; margin-bottom: 8px;
}
.imp-item.review { border-color: #fcd34d; }
.imp-item.outofscope { background: #fafafa; }
.imp-item-head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 6px; }
.imp-item-head input[type=checkbox] { width: 16px; height: 16px; margin: 0; }
.imp-reg {
    font-size: 17px; font-weight: 700; color: #1d4ed8; text-decoration: none; white-space: nowrap;
}
.imp-reg:hover { text-decoration: underline; }
.imp-reg.plain { color: #0f172a; }
.imp-badge {
    display: inline-block; font-size: 11px; font-weight: 700; color: #fff;
    padding: 2px 8px; border-radius: 4px; white-space: nowrap;
}
.imp-state {
    display: inline-block; font-size: 11px; font-weight: 700;
    padding: 2px 8px; border-radius: 4px; white-space: nowrap;
}
.imp-state.exist { background: #e0f2fe; color: #075985; }
.imp-state.new   { background: #dcfce7; color: #166534; }
.imp-state.done  { background: #dcfce7; color: #166534; }
.imp-state.moved { background: #ede9fe; color: #5b21b6; }
.imp-date { margin-left: auto; font-size: 13px; color: #94a3b8; white-space: nowrap; }

.imp-event { font-size: 13px; color: #475569; line-height: 1.7; padding-left: 2px; }
.imp-event .ev-type { font-weight: 600; color: #334155; }
.imp-event .ev-date { color: #94a3b8; font-family: monospace; margin-right: 6px; }

/* その場編集フォーム */
.imp-edit {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 8px 14px; margin-top: 10px; padding-top: 10px; border-top: 1px dashed #e2e8f0;
}
.imp-field { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
.imp-field label { margin: 0; font-size: 12px; font-weight: 600; color: #64748b; }
.imp-field select, .imp-field input[type=text] {
    height: 32px; max-width: 100%; padding: 3px 8px; font-size: 13px;
    border: 1px solid #cbd5e1; border-radius: 6px; background: #fff; color: #1e293b;
}
.imp-field .imp-was { font-size: 11px; color: #94a3b8; }
.imp-field.wide { grid-column: 1 / -1; }
.imp-field label.imp-inline {
    display: flex; align-items: center; gap: 6px;
    font-size: 13px; font-weight: 600; color: #475569;
}
.imp-field label.imp-inline input[type=checkbox] { width: 15px; height: 15px; margin: 0; }

.imp-addtype, .imp-move {
    align-self: flex-start; padding: 0;
    border: none; background: none; color: #1d4ed8;
    font-size: 11px; font-weight: 600; text-decoration: underline; cursor: pointer;
}
.imp-addtype { margin-top: 2px; }
.imp-move { font-size: 12px; margin-left: auto; color: #64748b; }
.imp-move:hover { color: #334155; }

/* 詳細型式の新規登録モーダル */
.tdm-field { margin-bottom: 12px; }
.tdm-field label { display: block; margin: 0 0 3px; font-size: 12px; font-weight: 600; color: #64748b; }
.tdm-field select, .tdm-field input[type=text] {
    width: 100%; height: 34px; padding: 4px 10px; font-size: 14px;
    border: 1px solid #cbd5e1; border-radius: 6px; background: #fff; color: #1e293b;
}
.tdm-source {
    background: #f1f5f9; border-radius: 6px; padding: 8px 12px; margin-bottom: 14px;
    font-size: 13px; color: #475569;
}
.tdm-source b { color: #0f172a; font-family: monospace; }
.tdm-error {
    display: none; background: #fef2f2; border: 1px solid #fecaca; border-radius: 6px;
    padding: 8px 12px; font-size: 13px; color: #b91c1c; font-weight: 600;
}

/* DBの現在値から変わる項目 */
.imp-field.changed label { color: #b45309; }
.imp-field.changed select,
.imp-field.changed input[type=text] { border-color: #f59e0b; background: #fffbeb; }
.imp-field .imp-was.changed { color: #b45309; font-weight: 600; }

.imp-meta { font-size: 13px; color: #64748b; margin-top: 6px; display: flex; gap: 14px; flex-wrap: wrap; }
.imp-meta b { color: #334155; font-weight: 600; }
.imp-reason { font-size: 13px; color: #b45309; margin-top: 6px; }

.imp-empty { font-size: 13px; color: #94a3b8; padding: 8px 2px; }

/* 実行バー */
.imp-footer {
    position: sticky; bottom: 0; z-index: 10;
    display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
    background: #fff; border-top: 2px solid #e2e8f0;
    padding: 12px 4px; margin-top: 20px;
}
.imp-footer label { margin: 0; font-size: 13px; color: #475569; font-weight: 600; display: flex; align-items: center; gap: 6px; }
.imp-footer .imp-count { font-size: 14px; color: #0f172a; font-weight: 700; }

@@media (max-width: 600px) {
    .imp-date { margin-left: 0; width: 100%; }
    .imp-edit { grid-template-columns: 1fr; }
}
</style>
}

<div class="imp-page">
    <h2>📥 Excel取込プレビュー</h2>

    <div class="imp-filebar">
        <span class="imp-filename">@Model.FileName</span>
        <span class="imp-filemeta">
            @if (preview.Parsed.TargetMonth != null)
            {
                @($"対象月 {preview.Parsed.TargetMonth:yyyy年M月}　")
            }
            @($"{preview.Parsed.Records.Count}件のレコード / {preview.Items.Count}レジ")
        </span>
        @if (Model.SavedAt != null)
        {
            <span class="imp-filemeta">最終保存 @Model.SavedAt?.ToString("MM/dd HH:mm")</span>
        }
        <span style="margin-left:auto;display:flex;gap:10px">
            @if (Model.SessionId != null)
            {
                <a class="imp-btn" href="@Url.Action("Download", "JcabImport", new { id = Model.SessionId })">復号版をダウンロード</a>
            }
            <a class="imp-btn primary" href="@Url.Action("Index", "JcabImport", new { fromAdmin = Model.FromAdmin })">取込画面に戻る</a>
        </span>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="imp-warn">⚠ @Model.ErrorMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="imp-saved">
            <span>✔ @Model.Message</span>
            @if (!string.IsNullOrEmpty(Model.SearchConditionKey))
            {
                <a class="imp-btn" href="/Search?sc=@Model.SearchConditionKey" target="_blank">検索結果を見る</a>
            }
            else
            {
                <span class="imp-saved-note">このまま編集を続けても、取込画面に戻って後から再開しても構いません。</span>
            }
            <a class="imp-btn" href="@Url.Action("Index", "JcabImport", new { fromAdmin = Model.FromAdmin })">取込画面に戻る</a>
        </div>
    }

    @if (Model.ImportedRegistrations.Any())
    {
        <partial name="_SearchConditionBox" model="Model" />
    }

    @* 区分ごとの件数 *@
    <div class="imp-stats">
        @foreach (JcabRecordType type in Enum.GetValues<JcabRecordType>())
        {
            int count = preview.Parsed.CountOf(type);
            <span class="imp-chip" style="background:@typeColors[type]">
                @type.ToJapanese() <span class="cnt">@count</span>
            </span>
        }
    </div>

    @if (preview.Parsed.Warnings.Any())
    {
        <div class="imp-warn">
            @foreach (string warning in preview.Parsed.Warnings)
            {
                <div>⚠ @warning</div>
            }
        </div>
    }

    @* セレクトの選択肢は行数分だけ書き出すと巨大になるので、ここに1組だけ置いてJSで各行に配る *@
    <template data-options="airline">
        <option value="">　</option>
        @foreach (var airline in Model.AirlineList ?? [])
        {
            <option value="@airline.AirlineCode">@airline.AirlineNameJpShort</option>
        }
    </template>
    <template data-options="typeDetail">
        <option value="">　</option>
        @foreach (var typeDetail in Model.TypeDetailList ?? [])
        {
            <option value="@typeDetail.TypeDetailId">@typeDetail.TypeDetailName</option>
        }
    </template>
    <template data-options="operation">
        <option value="">　</option>
        @foreach (var operation in Model.OperationList ?? [])
        {
            <option value="@operation.Key">@operation.Value</option>
        }
    </template>

    <form method="post" asp-controller="JcabImport" asp-action="Execute" id="importForm">
        <input type="hidden" name="SessionId" value="@Model.SessionId" />
        <input type="hidden" name="FileName" value="@Model.FileName" />
        <input type="hidden" name="FromAdmin" value="@Model.FromAdmin.ToString().ToLowerInvariant()" />

        @foreach (var group in groups)
        {
            List<ImportPreviewItem> items = preview.Of(group.Category).ToList();
            <div class="imp-group">
                <div class="imp-group-head">
                    <span class="imp-group-title">@group.Icon @group.Title</span>
                    <span class="imp-group-note"><span class="imp-group-count" data-count-for="@group.Id">@items.Count</span> 件 — @group.Note</span>
                    <span class="imp-group-tools">
                        <button type="button" class="imp-btn" style="padding:4px 12px;font-size:13px"
                                data-select-target="@group.Id" data-select-value="1">全選択</button>
                        <button type="button" class="imp-btn" style="padding:4px 12px;font-size:13px"
                                data-select-target="@group.Id" data-select-value="0">全解除</button>
                        <button type="button" class="imp-btn" style="padding:4px 14px;font-size:13px"
                                data-toggle-target="@group.Id">@(group.Collapsed ? "表示" : "隠す")</button>
                    </span>
                </div>

                <div id="@group.Id" class="imp-section" style="@(group.Collapsed ? "display:none" : "")">
                    @* 行を移動すると件数が変わるので、常に置いておいてJSで出し分ける *@
                    <div class="imp-empty imp-section-empty" style="@(items.Count == 0 ? "" : "display:none")">該当なし</div>
                    @foreach (ImportPreviewItem item in items)
                    {
                        string key = item.RegistrationNumber;

                        @* 既存機について、初期値がDBの現在値と変わる項目は色付けして変更前を出す *@
                        string airlineName(string? code) => Model.AirlineList?.FirstOrDefault(a => a.AirlineCode == code)?.AirlineNameJpShort ?? code ?? "―";
                        string operationName(string? code) => Model.OperationList?.FirstOrDefault(o => o.Key == code)?.Value ?? code ?? "―";

                        bool airlineChanged = item.ExistsInJafleet && item.CurrentAirline != item.EditAirline;
                        bool typeChanged = item.ExistsInJafleet && item.CurrentTypeDetailId != item.EditTypeDetailId;
                        bool operationChanged = item.ExistsInJafleet && item.CurrentOperationCode != item.EditOperationCode;
                        bool registerDateChanged = item.ExistsInJafleet && item.CurrentRegisterDate != item.EditRegisterDate;
                        bool serialChanged = item.ExistsInJafleet && item.CurrentSerialNumber != item.EditSerialNumber;
                        bool remarksChanged = item.ExistsInJafleet && item.CurrentRemarks != item.EditRemarks;

                        <div class="imp-item @(item.Category == ImportCategory.NeedsReview ? "review" : "") @(item.Category == ImportCategory.OutOfScope ? "outofscope" : "")"
                             data-reg="@key">
                            @* レジをキーにしているので、行を移動しても番号を振り直さなくてよい *@
                            <input type="hidden" name="Rows.Index" value="@key" />
                            <input type="hidden" name="Rows[@key].RegistrationNumber" value="@key" />
                            <input type="hidden" name="Rows[@key].Category" value="@item.Category" class="imp-category" />

                            <div class="imp-item-head">
                                <input type="checkbox" name="Rows[@key].Selected" value="true" class="imp-select" checked="@item.Selected" />
                                @if (item.ExistsInJafleet)
                                {
                                    <a class="imp-reg" href="/AD/@key" target="_blank">@key</a>
                                    <span class="imp-state exist">既存</span>
                                }
                                else
                                {
                                    <span class="imp-reg plain">@key</span>
                                    <span class="imp-state new">未登録</span>
                                }
                                @if (item.Imported)
                                {
                                    <span class="imp-state done">取込済</span>
                                }
                                @if (item.MovedByUser)
                                {
                                    <span class="imp-state moved">手動移動</span>
                                }
                                @foreach (JcabRecord ev in item.Events)
                                {
                                    <span class="imp-badge" style="background:@typeColors[ev.RecordType]">@ev.RecordType.ToJapanese()</span>
                                }
                                <span class="imp-date">@item.LatestDate</span>
                            </div>

                            @foreach (JcabRecord ev in item.Events)
                            {
                                <div class="imp-event">
                                    <span class="ev-date">@(ev.RegisterDate ?? ev.RegisterDateRaw ?? "日付不明")</span>
                                    <span class="ev-type">@ev.RecordType.ToJapanese()</span>
                                    <span>@Summarize(ev)</span>
                                </div>
                            }

                            <div class="imp-edit">
                                <div class="imp-field @(airlineChanged ? "changed" : "")">
                                    <label>航空会社</label>
                                    <select name="Rows[@key].Airline" data-options="airline" data-selected="@item.EditAirline"></select>
                                    @if (airlineChanged)
                                    {
                                        <span class="imp-was changed">変更前: @airlineName(item.CurrentAirline)</span>
                                    }
                                </div>

                                <div class="imp-field @(typeChanged ? "changed" : "")">
                                    <label>詳細型式</label>
                                    <select name="Rows[@key].TypeDetailId" data-options="typeDetail" data-selected="@item.EditTypeDetailId"></select>
                                    @if (typeChanged)
                                    {
                                        <span class="imp-was changed">変更前: @(item.CurrentTypeDetailName ?? "―")</span>
                                    }
                                    @if (!string.IsNullOrEmpty(item.TypeDisplay))
                                    {
                                        <span class="imp-was">Excel: @item.TypeDisplay</span>
                                    }
                                    @if (item.EditTypeDetailId is null or 0)
                                    {
                                        @* マスタに無い型式はここから直接登録できるようにする *@
                                        <button type="button" class="imp-addtype"
                                                data-select="Rows[@key].TypeDetailId"
                                                data-source="@item.TypeDisplay"
                                                data-name="@TextUtil.Widen(item.TypeNameRaw)">
                                            ＋ 詳細型式を新規登録
                                        </button>
                                    }
                                </div>

                                <div class="imp-field @(operationChanged ? "changed" : "")">
                                    <label>運用状況</label>
                                    <select name="Rows[@key].OperationCode" data-options="operation" data-selected="@item.EditOperationCode"></select>
                                    @if (operationChanged)
                                    {
                                        <span class="imp-was changed">変更前: @operationName(item.CurrentOperationCode)</span>
                                    }
                                </div>

                                <div class="imp-field @(registerDateChanged ? "changed" : "")">
                                    <label>登録年月日</label>
                                    <input type="text" name="Rows[@key].RegisterDate" value="@item.EditRegisterDate" placeholder="yyyy/MM/dd" />
                                    @if (registerDateChanged)
                                    {
                                        <span class="imp-was changed">変更前: @(item.CurrentRegisterDate ?? "―")</span>
                                    }
                                </div>

                                <div class="imp-field @(serialChanged ? "changed" : "")">
                                    <label>製造番号</label>
                                    <input type="text" name="Rows[@key].SerialNumber" value="@item.EditSerialNumber" />
                                    @if (serialChanged)
                                    {
                                        <span class="imp-was changed">変更前: @(item.CurrentSerialNumber ?? "―")</span>
                                    }
                                </div>

                                <div class="imp-field @(remarksChanged ? "changed" : "")">
                                    <label>備考</label>
                                    <input type="text" name="Rows[@key].Remarks" value="@item.EditRemarks" />
                                    @if (remarksChanged)
                                    {
                                        <span class="imp-was changed">変更前: @(item.CurrentRemarks ?? "―")</span>
                                    }
                                </div>

                                <div class="imp-field wide" style="flex-direction:row;align-items:center;gap:14px">
                                    <label class="imp-inline">
                                        <input type="checkbox" name="Rows[@key].NotUpdateDate" value="true" class="imp-nohistory" checked="@item.NotUpdateDate" />
                                        履歴を作成しない
                                    </label>
                                    <button type="button" class="imp-move"
                                            data-move-to="@(item.Category == ImportCategory.OutOfScope ? nameof(ImportCategory.NeedsReview) : nameof(ImportCategory.OutOfScope))">
                                        @(item.Category == ImportCategory.OutOfScope ? "→ 要確認に戻す" : "→ 対象外にする")
                                    </button>
                                </div>
                            </div>

                            @if (item.Reasons.Any())
                            {
                                <div class="imp-reason">@string.Join(" / ", item.Reasons)</div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        <div class="imp-footer">
            <label><input type="checkbox" id="noHistoryAll" /> 全行「履歴を作成しない」</label>
            <span class="imp-count"><span id="selectedCount">0</span> 件を取込</span>
            <button type="submit" class="imp-btn" formaction="@Url.Action("Save", "JcabImport")" style="margin-left:auto">一時保存</button>
            <button type="submit" class="imp-btn primary">取込を実行</button>
        </div>
    </form>

    @* 取込フォームの中に置くと入力値まで送信されてしまうのでフォームの外に出す *@
    <div class="modal fade" id="typeDetailModal" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="閉じる"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title">詳細型式の新規登録</h4>
                </div>
                <div class="modal-body">
                    <div class="tdm-source">Excelの型式: <b id="tdSource"></b></div>

                    <div class="tdm-field">
                        <label for="tdTypeCode">型式</label>
                        <select id="tdTypeCode">
                            <option value="">　</option>
                            @foreach (var type in Model.TypeList ?? [])
                            {
                                <option value="@type.TypeCode">@type.TypeName</option>
                            }
                        </select>
                    </div>

                    <div class="tdm-field">
                        <label for="tdName">詳細型式名</label>
                        <input type="text" id="tdName" />
                    </div>

                    <div class="tdm-field">
                        <label for="tdCode">詳細型式コード（任意）</label>
                        <input type="text" id="tdCode" />
                    </div>

                    <div class="tdm-error" id="tdError"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="imp-btn" data-dismiss="modal">キャンセル</button>
                    <button type="button" class="imp-btn primary" id="tdSubmit">登録して選択</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section ScriptsPartial{
<script>
    $(function () {
        // ---- セレクトの選択肢をテンプレートから配る ----
        const templates = {};
        $('template[data-options]').each(function () {
            templates[$(this).data('options')] = this.content;
        });

        const fillSelect = function (select) {
            const content = templates[select.dataset.options];
            if (!content) { return; }
            select.appendChild(content.cloneNode(true));
            const selected = select.dataset.selected;
            if (selected) { select.value = selected; }
        };

        $('select[data-options]').each(function () { fillSelect(this); });

        // 新しく登録したマスタは、テンプレートと画面内の同じ種類のセレクトすべてに配る
        const addOptionToAll = function (kind, value, text) {
            const optionValue = String(value);
            const selector = 'option[value="' + optionValue.replace(/"/g, '\\"') + '"]';

            $('select[data-options="' + kind + '"]').each(function () {
                if (this.querySelector(selector)) { return; }
                //選択肢を足しただけで選択中の値が変わらないようにしておく
                const current = this.value;
                this.add(new Option(text, optionValue));
                this.value = current;
            });

            const template = templates[kind];
            if (template && !template.querySelector(selector)) {
                template.appendChild(new Option(text, optionValue));
            }
        };

        // ---- 選択件数 ----
        const refreshCount = function () {
            $('#selectedCount').text($('.imp-select:checked').length);
        };

        const refreshSectionCounts = function () {
            $('.imp-section').each(function () {
                const count = $(this).find('.imp-item').length;
                $('[data-count-for="' + this.id + '"]').text(count);
                $(this).find('.imp-section-empty').toggle(count === 0);
            });
        };

        $('[data-toggle-target]').on('click', function () {
            const target = $('#' + $(this).data('toggle-target'));
            target.toggle();
            $(this).text(target.is(':visible') ? '隠す' : '表示');
        });

        $('[data-select-target]').on('click', function () {
            const target = $('#' + $(this).data('select-target'));
            target.find('.imp-select').prop('checked', $(this).data('select-value') === 1);
            refreshCount();
        });

        $('#noHistoryAll').on('change', function () {
            $('.imp-nohistory').prop('checked', $(this).prop('checked'));
        });

        $(document).on('change', '.imp-select', refreshCount);

        // ---- セクション間の移動 ----
        const sectionIdOf = { 'Ready': 'group-ready', 'Transfer': 'group-transfer', 'NeedsReview': 'group-review', 'OutOfScope': 'group-outofscope' };

        $(document).on('click', '.imp-move', function () {
            const button = $(this);
            const row = button.closest('.imp-item');
            const to = button.data('move-to');

            row.find('.imp-category').val(to);
            row.removeClass('review outofscope');

            if (to === 'OutOfScope') {
                row.addClass('outofscope');
                row.find('.imp-select').prop('checked', false);
                button.data('move-to', 'NeedsReview').text('→ 要確認に戻す');
            } else {
                row.addClass('review');
                button.data('move-to', 'OutOfScope').text('→ 対象外にする');
            }

            const target = $('#' + sectionIdOf[to]);
            target.append(row);
            if (!target.is(':visible')) {
                target.show();
                $('[data-toggle-target="' + target.attr('id') + '"]').text('隠す');
            }

            refreshSectionCounts();
            refreshCount();
        });

        // ---- 詳細型式の新規登録モーダル ----
        let targetSelectName = null;

        $(document).on('click', '.imp-addtype', function () {
            targetSelectName = $(this).data('select');
            $('#tdSource').text($(this).data('source') || '');
            $('#tdName').val($(this).data('name') || '');
            $('#tdCode').val($(this).data('name') || '');
            $('#tdTypeCode').val('');
            $('#tdError').hide().text('');
            $('#typeDetailModal').modal('show');
        });

        $('#tdSubmit').on('click', function () {
            const button = $(this);
            button.prop('disabled', true);

            $.ajax({
                url: '/JcabImport/CreateTypeDetail',
                type: 'POST',
                data: {
                    typeCode: $('#tdTypeCode').val(),
                    typeDetailCode: $('#tdCode').val(),
                    typeDetailName: $('#tdName').val()
                }
            }).done(function (data) {
                if (data.error) {
                    $('#tdError').text(data.error).show();
                    return;
                }

                // 追加した詳細型式は、登録した行だけでなく画面内すべての行から選べるようにする
                addOptionToAll('typeDetail', data.id, data.name);

                const target = $('select[name="' + targetSelectName + '"]');
                target.val(data.id);

                // 型式が決まったので、その行を取込対象にしておく
                const row = target.closest('.imp-item');
                row.find('.imp-select').prop('checked', true);
                row.find('.imp-addtype').remove();
                refreshCount();

                $('#typeDetailModal').modal('hide');
            }).fail(function (xhr) {
                $('#tdError').text('登録に失敗しました (' + xhr.status + ' ' + xhr.statusText + ')').show();
            }).always(function () {
                button.prop('disabled', false);
            });
        });

        refreshSectionCounts();
        refreshCount();
    });
</script>
}
