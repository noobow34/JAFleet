<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>JAFleet</RootNamespace>
    <PrepareForBuildDependsOn>BundleMinify;$(PrepareForBuildDependsOn)</PrepareForBuildDependsOn>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.7.1" />
    <PackageReference Include="AngleSharp.XPath" Version="2.0.6" />
    <PackageReference Include="AutoMapper" Version="16.2.0" />
    <PackageReference Include="Crc32.NET" Version="1.2.0" />
    <PackageReference Include="BuildBundlerMinifier" Version="3.2.449" />
    <PackageReference Include="EPPlus" Version="8.6.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Quartz" Version="3.18.2" />
    <PackageReference Include="WebEssentials.AspNetCore.PWA" Version="1.0.85" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Views\Aircraft\" />
    <Folder Include="Views\Search\" />
    <Folder Include="wwwroot\lib\bootstrap\locales\" />
    <Folder Include="Views\E\" />
    <Folder Include="Views\Sandbox\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\JAFleet.Commons\JAFleet.Commons\JAFleet.Commons.csproj" />
    <ProjectReference Include="..\..\Noobow.Commons\Noobow.Commons\Noobow.Commons.csproj" />
  </ItemGroup>
  <!-- ビルド時のgitコミットハッシュとコミット日時をアセンブリメタデータに埋め込む（管理者向けのバージョン表示用）。
       -p:CommitHash=xxx -p:CommitDate=yyyy-MM-ddTHH:mm:ss+09:00 を指定すればgit実行をスキップして上書きできる。
       gitが無い/失敗した環境ではExitCodeを見て"unknown"にフォールバックする
       （終了コードを確認しないと、シェルのエラーメッセージ自体が値として埋め込まれてしまう）。
       ビルド日時は埋め込まない。毎回値が変わってインクリメンタルビルドが効かなくなるため。 -->
  <Target Name="EmbedCommitInfo" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git rev-parse --short HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" Condition="'$(CommitHash)' == ''">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommitHashOutput" />
      <Output TaskParameter="ExitCode" PropertyName="_GitCommitHashExitCode" />
    </Exec>
    <!-- Windowsのcmdはバッチ中の単独の%を消すため二重にする（/bin/shでは二重にするとそのまま渡ってしまう） -->
    <PropertyGroup>
      <_GitPercent>%25</_GitPercent>
      <_GitPercent Condition="$([MSBuild]::IsOSPlatform('Windows'))">%25%25</_GitPercent>
    </PropertyGroup>
    <Exec Command="git log -1 --format=$(_GitPercent)cI" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" Condition="'$(CommitDate)' == ''">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommitDateOutput" />
      <Output TaskParameter="ExitCode" PropertyName="_GitCommitDateExitCode" />
    </Exec>
    <PropertyGroup>
      <CommitHash Condition="'$(CommitHash)' == '' and '$(_GitCommitHashExitCode)' == '0'">$(_GitCommitHashOutput)</CommitHash>
      <CommitHash Condition="'$(CommitHash)' == ''">unknown</CommitHash>
      <CommitDate Condition="'$(CommitDate)' == '' and '$(_GitCommitDateExitCode)' == '0'">$(_GitCommitDateOutput)</CommitDate>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyMetadata Include="CommitHash" Value="$(CommitHash)" />
      <AssemblyMetadata Include="CommitDate" Value="$(CommitDate)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <Content Update="wwwroot\css\site.min.css">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\js\site.min.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>