@{
    Model.Title = "検索";
    Model.TableId = "SerachResult";
}
@model SearchModel
@section HeadPartial{
    <meta name="description" content="航空会社・型式・運用状況・WiFi搭載状況などの条件で機材（飛行機）を検索するページです。">
}
@section CssPartial{
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-multiselect/0.9.15/css/bootstrap-multiselect.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/magnific-popup.js/1.1.0/magnific-popup.min.css" integrity="sha256-PZLhE6wwMbg4AB3d35ZdBF9HD/dI/y4RazA3iRDurss=" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/fleet-list.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/search.css" asp-append-version="true" />
}
<div class="sx">
    <h2 class="sx-title">機体を検索</h2>

    <section class="sx-card" id="sxCard">
        @* スマホで検索したあとは条件を畳み、選んだ条件を要約して出す *@
        <div class="sx-summary">
            <div class="sx-summary-chips" id="sxChips"></div>
            <button type="button" class="sx-btn" id="sxEdit">条件を変更</button>
        </div>

        <div class="sx-body">
            <div class="sx-preset">
                <label class="sx-label" for="PresetSearchCondition">保存済みの条件</label>
                <div class="sx-preset-row">
                    <div class="sx-grow">
                        @Html.DropDownList("PresetSearchCondition", new SelectList(Model.PresetSearchConditionList, "SearchConditionKey", "SearchConditionName"), "（選んでください）")
                    </div>
                    <button type="button" id="presetDisp" class="sx-btn" disabled="disabled">呼び出す</button>
                </div>
            </div>

            <div class="sx-grid">
                <div class="sx-field">
                    <label class="sx-label" for="RegistrationNumber">機体記号 <span class="sx-hint">正規表現も使える</span></label>
                    @Html.TextBoxFor(model => model.RegistrationNumber, new { @class = "sx-input mono", placeholder = "JA801A / JA8.*", autocomplete = "off", autocapitalize = "characters" })
                </div>
                <div class="sx-field">
                    <label class="sx-label" for="Airline">航空会社</label>
                    @Html.DropDownListFor(model => model.Airline, new SelectList(Model.AirlineList, "AirlineCode", "AirlineNameJpShort", null, "AirlineGroup"), new { @multiple = "multiple" })
                </div>
                <div class="sx-field">
                    <label class="sx-label" for="TypeDetail">型式</label>
                    @Html.DropDownListFor(model => model.TypeDetail, new SelectList(Model.TypeDetailList, "TypeDetailId", "TypeDetailName", null, "TypeName"), new { @multiple = "multiple" })
                </div>
                <div class="sx-field">
                    <label class="sx-label" for="OperationCode">運用状況</label>
                    @Html.DropDownListFor(model => model.OperationCode, new SelectList(Model.OperationList, "Key", "Value", null, "OptGroup"), new { @multiple = "multiple" })
                </div>
                <div class="sx-field">
                    <label class="sx-label" for="WiFiCode">Wi-Fi</label>
                    @Html.DropDownListFor(model => model.WiFiCode, new SelectList(Model.WiFiList, "Key", "Value"), new { @multiple = "multiple" })
                </div>
                <div class="sx-field">
                    <label class="sx-label" for="RegistrationDate">登録年月</label>
                    <div class="sx-inline">
                        @Html.TextBoxFor(model => model.RegistrationDate, new { @class = "sx-input", type = "month" })
                        @Html.DropDownListFor(model => model.RegistrationSelection, Model.RegistrationSelectionList, new { @class = "sx-input sx-narrow", aria_label = "登録年月の範囲" })
                    </div>
                </div>
                <div class="sx-field">
                    <label class="sx-label" for="SpecialLiveryList">特別塗装</label>
                    @Html.DropDownListFor(model => model.SpecialLiveryList, Model.SpecialLiveryList, "指定しない", new { @class = "sx-input" })
                    @Html.TextBoxFor(model => model.SpecialLiveryKeyword, new { @class = "sx-input sx-keyword", placeholder = "塗装名のキーワード", @disabled = "true", aria_label = "特別塗装のキーワード" })
                </div>
                <div class="sx-field">
                    <label class="sx-label" for="RemarksList">備考</label>
                    @Html.DropDownListFor(model => model.RemarksList, Model.RemarksList, "指定しない", new { @class = "sx-input" })
                    @Html.TextBoxFor(model => model.RemarksKeyword, new { @class = "sx-input sx-keyword", placeholder = "備考のキーワード", @disabled = "true", aria_label = "備考のキーワード" })
                </div>
            </div>
        </div>

        <div class="sx-actions">
            <button type="button" id="clear" class="sx-btn">クリア</button>
            <button type="button" id="presetReg" class="sx-btn">条件を保存</button>
            <button type="button" id="serach" class="sx-btn primary">検索</button>
        </div>
    </section>

    <div id="SerachResult"></div>
</div>

<div class="modal fade" id="modalPart" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body" id="modalMessage">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">閉じる</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="presetModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body">
                検索条件の名称を入力してください。<br />
                @Html.TextBox("presetName", null, null, new { @class = "form-control" })
                <label class="text-primary" id="presetResult"></label>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="presetRegModal">登録</button>
                <button type="button" class="btn btn-default" data-dismiss="modal">閉じる</button>
            </div>
        </div>
    </div>
</div>
@section ScriptsPartial{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/magnific-popup.js/1.1.0/jquery.magnific-popup.min.js" integrity="sha256-P93G0oq6PBPWTP1IR8Mz/0jHHUpaWL0aBJTKauisG7Q=" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-multiselect/0.9.15/js/bootstrap-multiselect.min.js" integrity="sha256-qoj3D1oB1r2TAdqKTYuWObh01rIVC1Gmw9vWp1+q5xw=" crossorigin="anonymous"></script>
    <script src="~/js/fleet-list.js" asp-append-version="true"></script>
    <script>
    var isLoading = true;
    var isDirect = @Model.IsDirect.ToString().ToLower();
    var fleet;

    // 複数選択のプルダウンの共通設定（見た目は search.css の .sx-ms で揃える）
    const MS_COMMON = {
        buttonWidth: '100%',
        buttonClass: 'sx-ms',
        nonSelectedText: '指定しない',
        nSelectedText: ' 件を選択',
        allSelectedText: 'すべて',
        numberDisplayed: 2,
        maxHeight: 360
    };
    const ms = function (opt) { return $.extend({}, MS_COMMON, opt); };

    // 特別塗装・備考は「キーワード指定」を選んだときだけキーワード欄を使う
    const LIVERY_KEYWORD = ['3', '5'];
    const REMARKS_KEYWORD = ['3'];
    const syncKeyword = function (selectId, keywordId, codes, keyword) {
        const on = codes.indexOf($(selectId).val()) >= 0;
        $(keywordId).prop('disabled', !on).val(on ? (keyword != null ? keyword : $(keywordId).val()) : '');
    };

    $(function () {
        $('#Airline').multiselect(ms({ enableClickableOptGroups: true, enableCollapsibleOptGroups: true }));
        $('#TypeDetail').multiselect(ms({ enableClickableOptGroups: true, enableCollapsibleOptGroups: true, enableFiltering: true, enableCaseInsensitiveFiltering: true, filterPlaceholder: '型式名で絞り込み', collapseOptGroupsByDefault: true }));
        $('#OperationCode').multiselect(ms({ enableClickableOptGroups: true, enableCollapsibleOptGroups: true }));
        $('#WiFiCode').multiselect(ms({}));
        $('#PresetSearchCondition').multiselect(ms({ enableFiltering: true, enableCaseInsensitiveFiltering: true, filterPlaceholder: '名前で絞り込み', nonSelectedText: '選んでください' }));

        @if (!string.IsNullOrEmpty(Model.TypeDetail))
        {
            @:$('#TypeDetail').multiselect('select', "@Model.TypeDetail".split("|"));
        }
        @if (!string.IsNullOrEmpty(Model.Airline))
        {
            @:$('#Airline').multiselect('select', "@Model.Airline".split("|"));
        }
        @if (!string.IsNullOrEmpty(Model.OperationCode))
        {
            @:$('#OperationCode').multiselect('select', "@Model.OperationCode".split("|"));
        }
        @if (!string.IsNullOrEmpty(Model.RegistrationSelection))
        {
            @:$('#RegistrationSelection').val("@Model.RegistrationSelection");
        }
        @if (!string.IsNullOrEmpty(Model.WiFiCode))
        {
            @:$('#WiFiCode').multiselect('select', "@Model.WiFiCode".split("|"));
        }
        @if (!string.IsNullOrEmpty(Model.Remarks))
        {
            @:$('#RemarksList').val("@Model.Remarks");
            @:syncKeyword('#RemarksList', '#RemarksKeyword', REMARKS_KEYWORD);
        }
        @if (!string.IsNullOrEmpty(Model.SpecialLivery))
        {
            @:$('#SpecialLiveryList').val("@Model.SpecialLivery");
            @:syncKeyword('#SpecialLiveryList', '#SpecialLiveryKeyword', LIVERY_KEYWORD);
        }
        @if (!string.IsNullOrEmpty(Model.RegistrationDate))
        {
            @:$('#RegistrationDate').val("@Model.RegistrationDate.Replace("/","-")");
        }

        fleet = FleetList.create('#SerachResult', {
            isAdmin: @(Model.IsAdmin ? "true" : "false"),
            emptyText: '条件を指定して「検索」を押してください'
        });
        doSearch();
    });

    // ---- 条件の要約（スマホで畳んだときに出す） ----
    const selectedTexts = function (selector) {
        return $(selector).find('option:selected').map(function () { return $.trim($(this).text()); }).get().filter(Boolean);
    };
    const shortList = function (list) {
        return list.length <= 2 ? list.join('、') : list.slice(0, 2).join('、') + ' ほか' + (list.length - 2);
    };
    const buildSummary = function () {
        const chips = [];
        const add = function (label, value) { if (value) { chips.push({ label: label, value: value }); } };
        add('機体記号', $.trim($('#RegistrationNumber').val()));
        add('航空会社', shortList(selectedTexts('#Airline')));
        add('型式', shortList(selectedTexts('#TypeDetail')));
        add('運用', shortList(selectedTexts('#OperationCode')));
        add('Wi-Fi', shortList(selectedTexts('#WiFiCode')));
        if ($('#RegistrationDate').val()) {
            add('登録', $('#RegistrationDate').val().replace('-', '/') + ' ' + $('#RegistrationSelection option:selected').text());
        }
        const withKeyword = function (selectId, keywordId) {
            if (!$(selectId).val()) { return ''; }
            const k = $.trim($(keywordId).val());
            return $(selectId + ' option:selected').text() + (k && !$(keywordId).prop('disabled') ? '「' + k + '」' : '');
        };
        add('特別塗装', withKeyword('#SpecialLiveryList', '#SpecialLiveryKeyword'));
        add('備考', withKeyword('#RemarksList', '#RemarksKeyword'));
        const esc = function (s) { return $('<span>').text(s).html(); };
        $('#sxChips').html(chips.length
            ? chips.map(function (c) { return '<span class="sx-chip"><b>' + esc(c.label) + '</b>' + esc(c.value) + '</span>'; }).join('')
            : '<span class="sx-chip empty">条件なし（すべての機体）</span>');
    };
    const isNarrow = function () { return window.matchMedia('(max-width: 767px)').matches; };
    const collapseForm = function () {
        if (!isNarrow()) { return; }
        buildSummary();
        $('#sxCard').addClass('is-collapsed');
    };
    $('#sxEdit').on('click', function () {
        $('#sxCard').removeClass('is-collapsed');
        $('html, body').animate({ scrollTop: $('#sxCard').offset().top - 90 }, 150);
    });

    // 検索して結果を一覧へ出す。開いた直後（isLoading）は URL の sc や直リンクの条件で検索される
    const doSearch = function () {
        const request = $.ajax({
            url: '/Search/DoSearch',
            type: 'POST',
            dataType: 'json',
            data: {
                RegistrationNumber: GetRegistrationNumber(),
                IsLoading: GetIsLoading(),
                isDirect: GetIsDirect(),
                Airline: GetAirline(),
                TypeDetail: GetType(),
                OperationCode: GetOperationCode(),
                RegistrationDate: GetRegistrationDate(),
                RegistrationSelection: GetRegistrationSelection(),
                WiFiCode: GetWiFiCode(),
                Remarks: GetRemarks(),
                RemarksKeyword: GetRemarksKeyword(),
                SpecialLivery: GetSpecialLivery(),
                SpecialLiveryKeyword: GetSpecialLiveryKeyword()
            }
        }).then(function (d) {
            if (d.searchConditionKey != "" && !GetIsDirect()) {
                history.pushState(null, null, "/Search?sc=" + d.searchConditionKey);
            }
            isDirect = false;
            if (d.errorMessage != null) {
                $('#modalMessage').text(d.errorMessage);
                $("#modalPart").modal();
            }
            else if (d.resultList.length == 0 && !isLoading) {
                $('#modalMessage').text("検索結果は0件です。");
                $("#modalPart").modal();
            }
            $('#PresetSearchCondition').multiselect('select', d.searchConditionKey);
            return d.resultList;
        });
        const wasLoading = isLoading;
        fleet.load(request).done(function (list) {
            if (wasLoading && list.length == 0) {
                fleet.clear();
            } else if (list.length > 0) {
                // 結果が出たらスマホでは条件を畳んで結果を見せる
                collapseForm();
            }
        });
    }

    $('#serach').click(function () {
        isLoading = false;
        fleet.resetSort();
        doSearch();
    });

    $('#RegistrationNumber, #SpecialLiveryKeyword, #RemarksKeyword').keypress(function (e) {
        if (e.keyCode == 13) {
            $('#serach').click();
        }
    });

    $('#clear').click(function () {
        ConditionAllClear();
        $('#PresetSearchCondition').multiselect('select', '');
        $('#PresetSearchCondition').multiselect('rebuild');
        fleet.clear();
        history.pushState(null, null, "/Search");
        $('#presetDisp').prop("disabled", true);
        $('#sxCard').removeClass('is-collapsed');
    });

    $('#presetDisp').click(function () {
        ReloadFromSCKey($('#PresetSearchCondition').val())
    });

    $('#presetReg').click(function () {
        $.ajax({
            url: '/Search/ExistsSeachCondition',
            type: 'POST',
            data: {
                RegistrationNumber: GetRegistrationNumber()
                , IsLoading: GetIsLoading()
                , isDirect: GetIsDirect()
                , Airline: GetAirline()
                , TypeDetail: GetType()
                , OperationCode: GetOperationCode()
                , RegistrationDate: GetRegistrationDate()
                , RegistrationSelection: GetRegistrationSelection()
                , WiFiCode: GetWiFiCode()
                , Remarks: GetRemarks()
                , RemarksKeyword: GetRemarksKeyword()
                , SpecialLivery: GetSpecialLivery()
                , SpecialLiveryKeyword: GetSpecialLiveryKeyword()
            },
            cache: false
        }).done(function (data) {
            if (data != "") {
                $('#modalMessage').text('この検索条件はすでに[' + data + ']として登録されています。');
                $("#modalPart").modal();
            } else {
                $("#presetName").val('');
                $('#presetResult').text('');
                $('#presetRegModal').show();
                $('#presetName').attr('readonly',false);
                $("#presetModal").modal();
            }
        }).fail(function () {
           alert('検索条件登録のための通信に失敗しました。繰り返し表示される場合は管理人にご連絡ください。')
       });
    });

    $('#presetRegModal').click(function () {
        if ($("#presetName").val() == "") {
            $('#presetResult').removeClass();
            $('#presetResult').addClass("text-danger");
            $('#presetResult').text("名称を入力してください");
            $("#presetName").focus();
            return;
        }
        $.ajax({
            url: '/Search/RegisterNamedSearchCondition',
            type: 'POST',
            data: {
                RegistrationNumber: GetRegistrationNumber()
                , IsLoading: GetIsLoading()
                , isDirect: GetIsDirect()
                , Airline: GetAirline()
                , TypeDetail: GetType()
                , OperationCode: GetOperationCode()
                , RegistrationDate: GetRegistrationDate()
                , RegistrationSelection: GetRegistrationSelection()
                , WiFiCode: GetWiFiCode()
                , Remarks: GetRemarks()
                , RemarksKeyword: GetRemarksKeyword()
                , SpecialLivery: GetSpecialLivery()
                , SpecialLiveryKeyword: GetSpecialLiveryKeyword()
                , SearchConditionName: $("#presetName").val()
            },
            cache: false
        }).done(function (data) {
            RefreshPresetSearchCondition(data);
            $('#presetResult').removeClass();
            $('#presetResult').addClass("text-primary");
            $('#presetResult').text("登録しました");
            $('#presetName').attr('readonly',true);
            $('#presetRegModal').hide();

        }).fail(function () {
           alert('検索条件登録に通信に失敗しました。繰り返し表示される場合は管理人にご連絡ください。')
       });
    });

    const RefreshPresetSearchCondition = function (vKey) {
        $.ajax({
        type: 'GET',
            url: '/Master/NamedSearchCondition/',
            cache: false
        }).done(function (data) {
            $('select#PresetSearchCondition option').remove();
            $('select#PresetSearchCondition').append($('<option>').text('（選んでください）').attr('value', ''));
            $.each(data, function (index, sc) {
                $('select#PresetSearchCondition').append($('<option>').text(sc.searchConditionName).attr('value', sc.searchConditionKey));
            });
            $('#PresetSearchCondition').multiselect('rebuild');
            $('#PresetSearchCondition').multiselect('select',vKey);
        });
    }

    $(window).on('popstate', function (e) {
        let sc = getParam('sc');
        if (sc != null) {
            isDirect = true;
            ReloadFromSCKey(getParam('sc'));
        } else {
            $('#clear').click();
        }
    });

    const GetRegistrationNumber = function ()  {
        return $('#RegistrationNumber').val();
    }

    const GetIsLoading = function ()  {
        return isLoading;
    }

    const GetIsDirect = function ()  {
        return isDirect;
    }

    const GetAirline = function ()  {
        let airline = $('#Airline').val().toString();
        return airline.replace(/,/g, '|');
    }

    const GetType = function ()  {
        let type = $('#TypeDetail').val().toString();
        return type.replace(/,/g, '|');
    }

    const GetRegistrationDate = function ()  {
        return $('#RegistrationDate').val().toString().replace('-', '/');
    }

    const GetRegistrationSelection = function ()  {
        return $('#RegistrationSelection').val();
    }

    const GetWiFiCode = function ()  {
        let type = $('#WiFiCode').val().toString();
        return type.replace(/,/g, '|');
    }

    const GetRemarks = function ()  {
        return $('#RemarksList').val();
    }

    const GetSpecialLivery = function ()  {
        return $('#SpecialLiveryList').val();
    }

    const GetRemarksKeyword = function ()  {
        return $('#RemarksKeyword').val();
    }

    const GetSpecialLiveryKeyword = function ()  {
        return $('#SpecialLiveryKeyword').val();
    }

    const GetOperationCode = function () {
        let operation = $('#OperationCode').val().toString();
        return operation.replace(/,/g, '|');
    }

    const GetSearchCondition = function (sc) {
        return $.ajax({
            type: 'POST',
            url: '/Search/GetSearchCondition',
            data: { searchCondition: sc },
            cache: false,
            async: false
        });
    }

    const ConditionAllClear = function () {
        $('#RegistrationNumber').val('');
        $('#Airline').multiselect("deselectAll", false).multiselect("refresh");
        $('#TypeDetail').multiselect("deselectAll", false).multiselect("refresh");
        $('#RegistrationDate').val('');
        $('#RegistrationSelection').val('0');
        $('#OperationCode').multiselect("deselectAll", false).multiselect("refresh");
        $('#WiFiCode').multiselect("deselectAll", false).multiselect("refresh");
        $('#SpecialLiveryList').val('');
        syncKeyword('#SpecialLiveryList', '#SpecialLiveryKeyword', LIVERY_KEYWORD);
        $('#RemarksList').val('');
        syncKeyword('#RemarksList', '#RemarksKeyword', REMARKS_KEYWORD);
    }

    const ReloadFromSCKey = function (scKey) {
        ConditionAllClear();
        GetSearchCondition(scKey).done(
            function (scJson) {
                if ('RegistrationNumber' in scJson && scJson.RegistrationNumber != null) {
                    $('#RegistrationNumber').val(scJson.RegistrationNumber);
                }
                if (scJson.Airline != null) {
                    $('#Airline').multiselect('select', scJson.Airline.split("|"));
                }
                if (scJson.TypeDetail != null) {
                    $('#TypeDetail').multiselect('select', scJson.TypeDetail.split("|"));
                }
                if (scJson.RegistrationDate != null) {
                    $('#RegistrationDate').val(scJson.RegistrationDate.replace("/", "-"));
                }
                if (scJson.RegistrationSelection != null) {
                    $('#RegistrationSelection').val(scJson.RegistrationSelection);
                }
                if (scJson.OperationCode != null) {
                    $('#OperationCode').multiselect('select', scJson.OperationCode.split("|"));
                }
                if (scJson.WiFiCode != null) {
                    $('#WiFiCode').multiselect('select', scJson.WiFiCode.split("|"));
                }
                if (scJson.SpecialLivery != null) {
                    $('#SpecialLiveryList').val(scJson.SpecialLivery);
                    syncKeyword('#SpecialLiveryList', '#SpecialLiveryKeyword', LIVERY_KEYWORD, scJson.SpecialLiveryKeyword);
                }
                if (scJson.Remarks != null) {
                    $('#RemarksList').val(scJson.Remarks);
                    syncKeyword('#RemarksList', '#RemarksKeyword', REMARKS_KEYWORD, scJson.RemarksKeyword);
                }
                $('#serach').click();
        });
    }

    $('#PresetSearchCondition').change(function () {
        $('#presetDisp').prop("disabled", $('#PresetSearchCondition').val() == "");
    });

    $('#RemarksList').change(function () {
        syncKeyword('#RemarksList', '#RemarksKeyword', REMARKS_KEYWORD);
        if (!$('#RemarksKeyword').prop('disabled')) { $('#RemarksKeyword').focus(); }
    });

    $('#SpecialLiveryList').change(function () {
        syncKeyword('#SpecialLiveryList', '#SpecialLiveryKeyword', LIVERY_KEYWORD);
        if (!$('#SpecialLiveryKeyword').prop('disabled')) { $('#SpecialLiveryKeyword').focus(); }
    });
    </script>
}
