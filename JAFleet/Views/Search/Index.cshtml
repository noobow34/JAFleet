@{
    Model.Title = "検索";
    Model.TableId = "SerachResult";
}
@model SearchModel
@section HeadPartial{
    <meta name="description" content="航空会社・型式・運用状況・WiFi搭載状況などの条件で機材（飛行機）を検索するページです。">
}
@section CssPartial{

    <link rel="stylesheet" href="~/css/fleet-list.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/search.css" asp-append-version="true" />
}
<div class="sx">
    <h2 class="sx-title">機体を検索</h2>

    <section class="sx-card" id="sxCard">
        @* スマホで検索したあとは条件を畳み、選んだ条件を要約して出す *@
        <div class="sx-summary">
            <div class="sx-summary-chips" id="sxChips"></div>
            <button type="button" class="sx-btn" id="sxEdit">条件を変更</button>
        </div>

        <div class="sx-body">
            <div class="sx-preset">
                <label class="sx-label" for="PresetSearchCondition">保存済みの条件</label>
                <div class="sx-preset-row">
                    <div class="sx-grow">
                        @Html.DropDownList("PresetSearchCondition", new SelectList(Model.PresetSearchConditionList, "SearchConditionKey", "SearchConditionName"), "（選んでください）")
                    </div>
                    <button type="button" id="presetDisp" class="sx-btn" disabled="disabled">呼び出す</button>
                </div>
            </div>

            <div class="sx-grid">
                <div class="sx-field">
                    <label class="sx-label" for="RegistrationNumber">機体記号 <span class="sx-hint">正規表現も使える</span></label>
                    @Html.TextBoxFor(model => model.RegistrationNumber, new { @class = "sx-input mono", placeholder = "JA801A / JA8.*", autocomplete = "off", autocapitalize = "characters" })
                </div>
                <div class="sx-field">
                    <label class="sx-label" for="Airline">航空会社</label>
                    @Html.DropDownListFor(model => model.Airline, new SelectList(Model.AirlineList, "AirlineCode", "AirlineNameJpShort", null, "AirlineGroup"), new { @multiple = "multiple" })
                </div>
                <div class="sx-field">
                    <label class="sx-label" for="TypeDetail">型式</label>
                    @Html.DropDownListFor(model => model.TypeDetail, new SelectList(Model.TypeDetailList, "TypeDetailId", "TypeDetailName", null, "TypeName"), new { @multiple = "multiple" })
                </div>
                <div class="sx-field">
                    <label class="sx-label" for="OperationCode">運用状況</label>
                    @Html.DropDownListFor(model => model.OperationCode, new SelectList(Model.OperationList, "Key", "Value", null, "OptGroup"), new { @multiple = "multiple" })
                </div>
                <div class="sx-field">
                    <label class="sx-label" for="WiFiCode">Wi-Fi</label>
                    @Html.DropDownListFor(model => model.WiFiCode, new SelectList(Model.WiFiList, "Key", "Value"), new { @multiple = "multiple" })
                </div>
                <div class="sx-field">
                    <label class="sx-label" for="RegistrationDate">登録年月</label>
                    <div class="sx-inline">
                        @Html.TextBoxFor(model => model.RegistrationDate, new { @class = "sx-input", type = "month" })
                        @Html.DropDownListFor(model => model.RegistrationSelection, Model.RegistrationSelectionList, new { @class = "sx-input sx-narrow", aria_label = "登録年月の範囲" })
                    </div>
                </div>
                <div class="sx-field">
                    <label class="sx-label" for="DeregistrationDate">抹消年月</label>
                    <div class="sx-inline">
                        @Html.TextBoxFor(model => model.DeregistrationDate, new { @class = "sx-input", type = "month" })
                        @Html.DropDownListFor(model => model.DeregistrationSelection, Model.RegistrationSelectionList, new { @class = "sx-input sx-narrow", aria_label = "抹消年月の範囲" })
                    </div>
                </div>
                <div class="sx-field">
                    <label class="sx-label" for="SpecialLiveryList">特別塗装</label>
                    @Html.DropDownListFor(model => model.SpecialLiveryList, Model.SpecialLiveryList, "指定しない", new { @class = "sx-input" })
                    @Html.TextBoxFor(model => model.SpecialLiveryKeyword, new { @class = "sx-input sx-keyword", placeholder = "塗装名のキーワード", @disabled = "true", aria_label = "特別塗装のキーワード" })
                </div>
                <div class="sx-field">
                    <label class="sx-label" for="RemarksList">備考</label>
                    @Html.DropDownListFor(model => model.RemarksList, Model.RemarksList, "指定しない", new { @class = "sx-input" })
                    @Html.TextBoxFor(model => model.RemarksKeyword, new { @class = "sx-input sx-keyword", placeholder = "備考のキーワード", @disabled = "true", aria_label = "備考のキーワード" })
                </div>
            </div>
        </div>

        <div class="sx-actions">
            <button type="button" id="clear" class="sx-btn">クリア</button>
            <button type="button" id="presetReg" class="sx-btn">条件を保存</button>
            <button type="button" id="serach" class="sx-btn primary">検索</button>
        </div>
    </section>

    <div id="SerachResult"></div>
</div>

<div class="modal fade" id="modalPart" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body" id="modalMessage">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">閉じる</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="presetModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body">
                検索条件の名称を入力してください。<br />
                @Html.TextBox("presetName", null, null, new { @class = "form-control" })
                <label class="text-primary" id="presetResult"></label>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="presetRegModal">登録</button>
                <button type="button" class="btn btn-default" data-dismiss="modal">閉じる</button>
            </div>
        </div>
    </div>
</div>
@section ScriptsPartial{
    <script src="~/js/jf-multiselect.min.js" asp-append-version="true"></script>
    <script src="~/js/fleet-list.js" asp-append-version="true"></script>
    <script>
    var isLoading = true;
    var isDirect = @Model.IsDirect.ToString().ToLower();
    var fleet;

    const byId = function (id) { return document.getElementById(id); };

    // 複数選択のプルダウンは自前の部品（jf-multiselect.js）。選んだ値は元の <select> に入るので、
    // 送る値や要約は <select> から読む。見た目は search.css の .sx-ms と .multiselect-container で揃える
    const pickers = {};
    const MS_COMMON = {
        buttonClass: 'sx-ms',
        nonSelectedText: '指定しない',
        nSelectedText: ' 件を選択',
        allSelectedText: 'すべて',
        numberDisplayed: 2,
        maxHeight: 360
    };
    const createMs = function (id, opt) {
        pickers[id] = JfMultiSelect.create(byId(id), Object.assign({}, MS_COMMON, opt));
    };
    const msSelect = function (id, values) { pickers[id].setSelected(values); };
    const msClear = function (id) { pickers[id].setSelected([]); };

    // 複数選択の値は「|」でつないで送る
    const multiValue = function (id) {
        return Array.from(byId(id).selectedOptions).map(function (o) { return o.value; }).join('|');
    };

    // 特別塗装・備考は「キーワード指定」を選んだときだけキーワード欄を使う
    const LIVERY_KEYWORD = ['3', '5'];
    const REMARKS_KEYWORD = ['3'];
    const syncKeyword = function (selectId, keywordId, codes, keyword) {
        const keywordBox = document.querySelector(keywordId);
        const on = codes.indexOf(document.querySelector(selectId).value) >= 0;
        keywordBox.disabled = !on;
        keywordBox.value = on ? (keyword != null ? keyword : keywordBox.value) : '';
    };

    JfDom.ready(function () {
        createMs('Airline', { clickableGroups: true, collapsibleGroups: true });
        createMs('TypeDetail', { clickableGroups: true, collapsibleGroups: true, collapseGroupsByDefault: true, filter: true, filterPlaceholder: '型式名で絞り込み' });
        createMs('OperationCode', { clickableGroups: true, collapsibleGroups: true });
        createMs('WiFiCode', {});
        createMs('PresetSearchCondition', { filter: true, filterPlaceholder: '名前で絞り込み', nonSelectedText: '選んでください' });

        @if (!string.IsNullOrEmpty(Model.TypeDetail))
        {
            @:msSelect('TypeDetail', "@Model.TypeDetail".split("|"));
        }
        @if (!string.IsNullOrEmpty(Model.Airline))
        {
            @:msSelect('Airline', "@Model.Airline".split("|"));
        }
        @if (!string.IsNullOrEmpty(Model.OperationCode))
        {
            @:msSelect('OperationCode', "@Model.OperationCode".split("|"));
        }
        @if (!string.IsNullOrEmpty(Model.RegistrationSelection))
        {
            @:byId('RegistrationSelection').value = "@Model.RegistrationSelection";
        }
        @if (!string.IsNullOrEmpty(Model.WiFiCode))
        {
            @:msSelect('WiFiCode', "@Model.WiFiCode".split("|"));
        }
        @if (!string.IsNullOrEmpty(Model.Remarks))
        {
            @:byId('RemarksList').value = "@Model.Remarks";
            @:syncKeyword('#RemarksList', '#RemarksKeyword', REMARKS_KEYWORD);
        }
        @if (!string.IsNullOrEmpty(Model.SpecialLivery))
        {
            @:byId('SpecialLiveryList').value = "@Model.SpecialLivery";
            @:syncKeyword('#SpecialLiveryList', '#SpecialLiveryKeyword', LIVERY_KEYWORD);
        }
        @if (!string.IsNullOrEmpty(Model.RegistrationDate))
        {
            @:byId('RegistrationDate').value = "@Model.RegistrationDate.Replace("/","-")";
        }
        @if (!string.IsNullOrEmpty(Model.DeregistrationDate))
        {
            @:byId('DeregistrationDate').value = "@Model.DeregistrationDate.Replace("/","-")";
        }
        @if (!string.IsNullOrEmpty(Model.DeregistrationSelection))
        {
            @:byId('DeregistrationSelection').value = "@Model.DeregistrationSelection";
        }

        byId('PresetSearchCondition').addEventListener('change', function () {
            byId('presetDisp').disabled = byId('PresetSearchCondition').value == "";
        });

        fleet = FleetList.create('#SerachResult', {
            isAdmin: @(Model.IsAdmin ? "true" : "false"),
            emptyText: '条件を指定して「検索」を押してください'
        });
        doSearch();
    });

    // ---- 条件の要約（スマホで畳んだときに出す） ----
    const selectedTexts = function (id) {
        return Array.from(byId(id).selectedOptions).map(function (o) { return o.text.trim(); }).filter(Boolean);
    };
    const selectedText = function (id) {
        const o = byId(id).selectedOptions[0];
        return o ? o.text : '';
    };
    const shortList = function (list) {
        return list.length <= 2 ? list.join('、') : list.slice(0, 2).join('、') + ' ほか' + (list.length - 2);
    };
    const buildSummary = function () {
        const chips = [];
        const add = function (label, value) { if (value) { chips.push({ label: label, value: value }); } };
        add('機体記号', byId('RegistrationNumber').value.trim());
        add('航空会社', shortList(selectedTexts('Airline')));
        add('型式', shortList(selectedTexts('TypeDetail')));
        add('運用', shortList(selectedTexts('OperationCode')));
        add('Wi-Fi', shortList(selectedTexts('WiFiCode')));
        if (byId('RegistrationDate').value) {
            add('登録', byId('RegistrationDate').value.replace('-', '/') + ' ' + selectedText('RegistrationSelection'));
        }
        if (byId('DeregistrationDate').value) {
            add('抹消', byId('DeregistrationDate').value.replace('-', '/') + ' ' + selectedText('DeregistrationSelection'));
        }
        const withKeyword = function (selectId, keywordId) {
            if (!byId(selectId).value) { return ''; }
            const keywordBox = byId(keywordId);
            const k = keywordBox.value.trim();
            return selectedText(selectId) + (k && !keywordBox.disabled ? '「' + k + '」' : '');
        };
        add('特別塗装', withKeyword('SpecialLiveryList', 'SpecialLiveryKeyword'));
        add('備考', withKeyword('RemarksList', 'RemarksKeyword'));
        const esc = function (s) { const span = document.createElement('span'); span.textContent = s; return span.innerHTML; };
        byId('sxChips').innerHTML = chips.length
            ? chips.map(function (c) { return '<span class="sx-chip"><b>' + esc(c.label) + '</b>' + esc(c.value) + '</span>'; }).join('')
            : '<span class="sx-chip empty">条件なし（すべての機体）</span>';
    };
    const isNarrow = function () { return window.matchMedia('(max-width: 767px)').matches; };
    const collapseForm = function () {
        if (!isNarrow()) { return; }
        buildSummary();
        byId('sxCard').classList.add('is-collapsed');
    };
    byId('sxEdit').addEventListener('click', function () {
        const card = byId('sxCard');
        card.classList.remove('is-collapsed');
        window.scrollTo({ top: card.getBoundingClientRect().top + window.scrollY - 90, behavior: 'smooth' });
    });

    const showMessage = function (text) {
        byId('modalMessage').textContent = text;
        JfUi.modal.show('#modalPart');
    };

    // 検索条件（保存・登録・検索で共通）
    const conditionData = function () {
        return {
            RegistrationNumber: GetRegistrationNumber(),
            IsLoading: GetIsLoading(),
            isDirect: GetIsDirect(),
            Airline: GetAirline(),
            TypeDetail: GetType(),
            OperationCode: GetOperationCode(),
            RegistrationDate: GetRegistrationDate(),
            RegistrationSelection: GetRegistrationSelection(),
            DeregistrationDate: GetDeregistrationDate(),
            DeregistrationSelection: GetDeregistrationSelection(),
            WiFiCode: GetWiFiCode(),
            Remarks: GetRemarks(),
            RemarksKeyword: GetRemarksKeyword(),
            SpecialLivery: GetSpecialLivery(),
            SpecialLiveryKeyword: GetSpecialLiveryKeyword()
        };
    };

    // 検索して結果を一覧へ出す。開いた直後（isLoading）は URL の sc や直リンクの条件で検索される
    const doSearch = function () {
        const request = JfHttp.post('/Search/DoSearch', conditionData()).then(function (d) {
            if (d.searchConditionKey != "" && !GetIsDirect()) {
                history.pushState(null, null, "/Search?sc=" + d.searchConditionKey);
            }
            isDirect = false;
            if (d.errorMessage != null) {
                showMessage(d.errorMessage);
            }
            else if (d.resultList.length == 0 && !isLoading) {
                showMessage("検索結果は0件です。");
            }
            msSelect('PresetSearchCondition', d.searchConditionKey);
            return d.resultList;
        });
        const wasLoading = isLoading;
        fleet.load(request).then(function (list) {
            if (!list) { return; }
            if (wasLoading && list.length == 0) {
                fleet.clear();
            } else if (list.length > 0) {
                // 結果が出たらスマホでは条件を畳んで結果を見せる
                collapseForm();
            }
        });
    }

    byId('serach').addEventListener('click', function () {
        isLoading = false;
        fleet.resetSort();
        doSearch();
    });

    ['RegistrationNumber', 'SpecialLiveryKeyword', 'RemarksKeyword'].forEach(function (id) {
        byId(id).addEventListener('keydown', function (e) {
            // 日本語入力の確定の Enter では検索しない
            if (e.key === 'Enter' && !e.isComposing) {
                byId('serach').click();
            }
        });
    });

    byId('clear').addEventListener('click', function () {
        ConditionAllClear();
        msSelect('PresetSearchCondition', '');
        fleet.clear();
        history.pushState(null, null, "/Search");
        byId('presetDisp').disabled = true;
        byId('sxCard').classList.remove('is-collapsed');
    });

    byId('presetDisp').addEventListener('click', function () {
        ReloadFromSCKey(byId('PresetSearchCondition').value)
    });

    const presetResult = function (className, text) {
        const result = byId('presetResult');
        result.className = className;
        result.textContent = text;
    };

    byId('presetReg').addEventListener('click', function () {
        JfHttp.post('/Search/ExistsSeachCondition', conditionData()).then(function (data) {
            if (data != "") {
                showMessage('この検索条件はすでに[' + data + ']として登録されています。');
            } else {
                byId('presetName').value = '';
                byId('presetResult').textContent = '';
                JfDom.show(byId('presetRegModal'));
                byId('presetName').readOnly = false;
                JfUi.modal.show('#presetModal');
            }
        }, function () {
            JfDialog.alert('検索条件登録のための通信に失敗しました。繰り返し表示される場合は管理人にご連絡ください。');
        });
    });

    byId('presetRegModal').addEventListener('click', function () {
        if (byId('presetName').value == "") {
            presetResult('text-danger', '名称を入力してください');
            byId('presetName').focus();
            return;
        }
        const data = conditionData();
        data.SearchConditionName = byId('presetName').value;
        JfHttp.post('/Search/RegisterNamedSearchCondition', data).then(function (key) {
            RefreshPresetSearchCondition(key);
            presetResult('text-primary', '登録しました');
            byId('presetName').readOnly = true;
            JfDom.hide(byId('presetRegModal'));
        }, function () {
            JfDialog.alert('検索条件登録の通信に失敗しました。繰り返し表示される場合は管理人にご連絡ください。');
        });
    });

    const RefreshPresetSearchCondition = function (vKey) {
        JfHttp.get('/Master/NamedSearchCondition/').then(function (data) {
            const select = byId('PresetSearchCondition');
            select.replaceChildren(new Option('（選んでください）', ''));
            data.forEach(function (sc) {
                select.add(new Option(sc.searchConditionName, sc.searchConditionKey));
            });
            pickers.PresetSearchCondition.rebuild();
            msSelect('PresetSearchCondition', vKey);
        });
    }

    window.addEventListener('popstate', function () {
        let sc = getParam('sc');
        if (sc != null) {
            isDirect = true;
            ReloadFromSCKey(getParam('sc'));
        } else {
            byId('clear').click();
        }
    });

    const GetRegistrationNumber = function () {
        return byId('RegistrationNumber').value;
    }

    const GetIsLoading = function () {
        return isLoading;
    }

    const GetIsDirect = function () {
        return isDirect;
    }

    const GetAirline = function () {
        return multiValue('Airline');
    }

    const GetType = function () {
        return multiValue('TypeDetail');
    }

    const GetRegistrationDate = function () {
        return byId('RegistrationDate').value.replace('-', '/');
    }

    const GetRegistrationSelection = function () {
        return byId('RegistrationSelection').value;
    }

    const GetDeregistrationDate = function () {
        return byId('DeregistrationDate').value.replace('-', '/');
    }

    const GetDeregistrationSelection = function () {
        return byId('DeregistrationSelection').value;
    }

    const GetWiFiCode = function () {
        return multiValue('WiFiCode');
    }

    const GetRemarks = function () {
        return byId('RemarksList').value;
    }

    const GetSpecialLivery = function () {
        return byId('SpecialLiveryList').value;
    }

    const GetRemarksKeyword = function () {
        return byId('RemarksKeyword').value;
    }

    const GetSpecialLiveryKeyword = function () {
        return byId('SpecialLiveryKeyword').value;
    }

    const GetOperationCode = function () {
        return multiValue('OperationCode');
    }

    // 以前は同期通信 (async: false) で取っていたが、ブラウザが非推奨にしているので Promise で返す
    const GetSearchCondition = function (sc) {
        return JfHttp.post('/Search/GetSearchCondition', { searchCondition: sc });
    }

    const ConditionAllClear = function () {
        byId('RegistrationNumber').value = '';
        msClear('Airline');
        msClear('TypeDetail');
        byId('RegistrationDate').value = '';
        byId('RegistrationSelection').value = '0';
        byId('DeregistrationDate').value = '';
        byId('DeregistrationSelection').value = '0';
        msClear('OperationCode');
        msClear('WiFiCode');
        byId('SpecialLiveryList').value = '';
        syncKeyword('#SpecialLiveryList', '#SpecialLiveryKeyword', LIVERY_KEYWORD);
        byId('RemarksList').value = '';
        syncKeyword('#RemarksList', '#RemarksKeyword', REMARKS_KEYWORD);
    }

    const ReloadFromSCKey = function (scKey) {
        ConditionAllClear();
        GetSearchCondition(scKey).then(function (scJson) {
            if (typeof scJson === 'string') { scJson = JSON.parse(scJson); }
            if ('RegistrationNumber' in scJson && scJson.RegistrationNumber != null) {
                byId('RegistrationNumber').value = scJson.RegistrationNumber;
            }
            if (scJson.Airline != null) {
                msSelect('Airline', scJson.Airline.split("|"));
            }
            if (scJson.TypeDetail != null) {
                msSelect('TypeDetail', scJson.TypeDetail.split("|"));
            }
            if (scJson.RegistrationDate != null) {
                byId('RegistrationDate').value = scJson.RegistrationDate.replace("/", "-");
            }
            if (scJson.RegistrationSelection != null) {
                byId('RegistrationSelection').value = scJson.RegistrationSelection;
            }
            if (scJson.DeregistrationDate != null) {
                byId('DeregistrationDate').value = scJson.DeregistrationDate.replace("/", "-");
            }
            if (scJson.DeregistrationSelection != null) {
                byId('DeregistrationSelection').value = scJson.DeregistrationSelection;
            }
            if (scJson.OperationCode != null) {
                msSelect('OperationCode', scJson.OperationCode.split("|"));
            }
            if (scJson.WiFiCode != null) {
                msSelect('WiFiCode', scJson.WiFiCode.split("|"));
            }
            if (scJson.SpecialLivery != null) {
                byId('SpecialLiveryList').value = scJson.SpecialLivery;
                syncKeyword('#SpecialLiveryList', '#SpecialLiveryKeyword', LIVERY_KEYWORD, scJson.SpecialLiveryKeyword);
            }
            if (scJson.Remarks != null) {
                byId('RemarksList').value = scJson.Remarks;
                syncKeyword('#RemarksList', '#RemarksKeyword', REMARKS_KEYWORD, scJson.RemarksKeyword);
            }
            byId('serach').click();
        });
    }

    byId('RemarksList').addEventListener('change', function () {
        syncKeyword('#RemarksList', '#RemarksKeyword', REMARKS_KEYWORD);
        if (!byId('RemarksKeyword').disabled) { byId('RemarksKeyword').focus(); }
    });

    byId('SpecialLiveryList').addEventListener('change', function () {
        syncKeyword('#SpecialLiveryList', '#SpecialLiveryKeyword', LIVERY_KEYWORD);
        if (!byId('SpecialLiveryKeyword').disabled) { byId('SpecialLiveryKeyword').focus(); }
    });
</script>
}
