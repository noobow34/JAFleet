@model EditModel
@{
    Layout = Model.NoHead ? "_LayoutNoHead" : "_Layout";
    Model.Title = Model.IsNew ? "新規" : Model.Aircraft?.RegistrationNumber;

    string fromAdmin = Model.FromAdmin.ToString().ToLowerInvariant();
    string? reg = Model.Aircraft?.RegistrationNumber;

    @* name・idは DropDownListFor が作っていたものと同じにして、既存のJSとモデルバインドをそのまま使う *@
    var typeDetailPicker = new TypeDetailPickerModel
    {
        FieldName = "Aircraft.TypeDetailId",
        FieldId = "Aircraft_TypeDetailId",
        SelectedId = Model.Aircraft?.TypeDetailId,
        TypeList = Model.TypeList,
        TypeDetailList = Model.TypeDetailList,
    };

    @* 航空会社と詳細型式はこの画面の入力から読むので、相手のidだけ渡す *@
    var seatConfigQuickAdd = new SeatConfigQuickAddModel
    {
        SelectId = "Aircraft_SeatConfig",
        AirlineFieldId = "Aircraft_Airline",
        TypeDetailFieldId = "Aircraft_TypeDetailId",
        TypeList = Model.TypeList,
        TypeDetailList = Model.TypeDetailList,
    };

    //見出しに出す、いまの値の名前
    string? airlineName = Model.AirlineList?.FirstOrDefault(a => a.AirlineCode == Model.Aircraft?.Airline)?.AirlineNameJpShort;
    string? typeDetailName = Model.TypeDetailList?.FirstOrDefault(t => t.TypeDetailId == Model.Aircraft?.TypeDetailId)?.TypeDetailName;
    string? operationName = Model.OperationList?.FirstOrDefault(c => c.Key == Model.Aircraft?.OperationCode)?.Value;
    bool? maintenance = Model.Aircraft?.MaintenanceNotify;
}

@section CssPartial {
<style>
/* ===== 単票編集 =====
   注意: Bootstrap3 が html{font-size:10px} を設定しているため remは使わずpxで指定すること。
   幅は スマホ（〜599px）= 1列、タブレット（600〜991px）= 項目2列、PC（992px〜）= カード2列。 */
.ed-page { max-width: 1120px; margin: 0 auto; padding: 8px 0 96px; color: #1e293b; }

/* ---- 見出し ---- */
.ed-head { display: flex; align-items: flex-start; gap: 12px; flex-wrap: wrap; margin: 4px 0 14px; }
.ed-title { flex: 1; min-width: 0; }
.ed-reg { margin: 0; font-family: Consolas, monospace; font-size: 30px; font-weight: 700; line-height: 1.2; letter-spacing: .02em; }
.ed-reg.new { font-family: inherit; font-size: 24px; }
.ed-chips { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 6px; }
.ed-chip {
    display: inline-flex; align-items: center; padding: 2px 10px; border-radius: 999px;
    border: 1px solid #e2e8f0; background: #f8fafc; font-size: 12px; font-weight: 600; color: #475569;
}
.ed-chip.livery { border-color: #fbcfe8; background: #fdf2f8; color: #9d174d; }
.ed-links { display: flex; gap: 6px; flex-wrap: wrap; }
.ed-link {
    display: inline-flex; align-items: center; gap: 4px; height: 34px; padding: 0 12px;
    border: 1px solid #cbd5e1; border-radius: 8px; background: #fff; color: #334155;
    font-size: 13px; font-weight: 600; text-decoration: none; cursor: pointer; white-space: nowrap;
}
.ed-link:hover, .ed-link:focus { background: #f1f5f9; color: #0f172a; text-decoration: none; }

/* ---- お知らせ ---- */
.ed-alert { border-radius: 10px; padding: 10px 14px; margin-bottom: 12px; font-size: 14px; font-weight: 600; line-height: 1.7; word-break: break-all; }
.ed-alert.ok { border: 1px solid #a7f3d0; background: #ecfdf5; color: #065f46; }
.ed-alert.ng { border: 1px solid #fecaca; background: #fef2f2; color: #b91c1c; }
.ed-alert pre { margin: 6px 0 0; max-height: 200px; overflow: auto; font-size: 11px; white-space: pre-wrap; background: transparent; border: 0; padding: 0; color: inherit; }

/* ---- 予約中の更新 ---- */
.ed-rsv { border: 1px solid #bfdbfe; background: #eff6ff; border-radius: 10px; padding: 10px 14px; margin-bottom: 14px; }
.ed-rsv-title { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; color: #1d4ed8; }
.ed-rsv-title a { margin-left: auto; font-size: 12px; font-weight: 600; }
.ed-rsv-row { display: flex; align-items: flex-start; gap: 10px; padding: 8px 0 0; margin-top: 8px; border-top: 1px dashed #bfdbfe; font-size: 13px; }
.ed-rsv-date { font-weight: 700; white-space: nowrap; }
.ed-rsv-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; word-break: break-all; }
.ed-rsv-src { font-size: 11px; color: #64748b; }
.ed-rsv-row form { margin: 0; }

/* ---- カードと項目 ---- */
.ed-cards { display: grid; gap: 14px; grid-template-columns: 1fr; }
.ed-card {
    border: 1px solid #e2e8f0; border-radius: 12px; background: #fff;
    padding: 14px 16px 16px; box-shadow: 0 1px 3px rgba(15,23,42,.05); min-width: 0;
}
.ed-card-title { display: flex; align-items: center; gap: 6px; margin: 0 0 12px; font-size: 14px; font-weight: 700; color: #0f172a; }
.ed-card-title .sub { font-size: 11px; font-weight: 600; color: #94a3b8; }
.ed-fields { display: grid; gap: 12px 14px; grid-template-columns: 1fr; }
.ed-field { min-width: 0; }
.ed-field.wide { grid-column: 1 / -1; }
.ed-field > label, .ed-label {
    display: flex; align-items: center; gap: 6px; margin: 0 0 4px;
    font-size: 12px; font-weight: 700; color: #64748b;
}
.ed-field.dirty > label::after, .ed-field.dirty > .ed-label::after {
    content: "変更"; padding: 0 6px; border-radius: 4px; background: #fef3c7; color: #92400e; font-size: 10px;
}
.ed-input {
    display: block; width: 100%; height: 40px; padding: 6px 10px;
    border: 1px solid #cbd5e1; border-radius: 8px; background: #fff; color: #0f172a;
    font-size: 15px; box-shadow: none; transition: border-color .15s, box-shadow .15s;
}
textarea.ed-input { height: auto; min-height: 76px; resize: vertical; line-height: 1.5; }
.ed-input:focus { outline: none; border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,.18); }
.ed-input[readonly] { background: #f8fafc; color: #64748b; }
.ed-input.mono { font-family: Consolas, monospace; }
.ed-field.dirty .ed-input, .ed-field.dirty .tdp-button { border-color: #f59e0b; background: #fffbeb; }
.ed-hint { margin-top: 4px; font-size: 11px; color: #94a3b8; line-height: 1.6; }
.ed-with-add { display: flex; gap: 6px; align-items: center; }
.ed-with-add > select { flex: 1; min-width: 0; }
.ed-with-add .scq-open { margin-left: 0; width: 40px; height: 40px; flex: 0 0 auto; }
.ed-field .tdp-button { height: 40px; border-radius: 8px; font-size: 15px; }

/* チェックボックスは押しやすいよう行ごと押せるようにする */
.ed-check {
    display: flex; align-items: flex-start; gap: 10px; margin: 0; padding: 10px 12px;
    border: 1px solid #e2e8f0; border-radius: 8px; background: #f8fafc; cursor: pointer;
    font-size: 14px; font-weight: 600; color: #334155; line-height: 1.5;
}
.ed-check input { width: 18px; height: 18px; margin: 1px 0 0; flex: 0 0 auto; }
.ed-check .ed-hint { font-weight: 400; margin-top: 2px; }
.ed-check.on { border-color: #fde68a; background: #fffbeb; }

/* 日時は読むだけのものが多いので小さく並べる */
.ed-times {
    display: grid; gap: 10px 14px; grid-template-columns: repeat(auto-fit, minmax(168px, 1fr));
    margin-top: 14px; padding-top: 12px; border-top: 1px dashed #e2e8f0;
}
.ed-times .ed-input { height: 36px; padding: 4px 8px; font-size: 13px; }

/* ---- 下の操作バー（常に見える） ---- */
.ed-bar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 1030;
    background: rgba(255,255,255,.96); border-top: 1px solid #e2e8f0;
    box-shadow: 0 -4px 16px rgba(15,23,42,.08);
    padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
}
.ed-bar-in { max-width: 1120px; margin: 0 auto; display: flex; align-items: center; gap: 8px; }
.ed-bar-state { flex: 1; min-width: 0; font-size: 12px; color: #64748b; line-height: 1.4; }
.ed-bar-state b { color: #b45309; }
.ed-bar-state .rsv { color: #1d4ed8; font-weight: 700; }
.ed-btn {
    display: inline-flex; align-items: center; justify-content: center; height: 44px; padding: 0 18px;
    border: 1px solid #cbd5e1; border-radius: 10px; background: #fff; color: #334155;
    font-size: 15px; font-weight: 700; cursor: pointer; white-space: nowrap; text-decoration: none;
}
.ed-btn:hover { background: #f1f5f9; color: #0f172a; text-decoration: none; }
.ed-btn.primary { min-width: 130px; background: #0f172a; border-color: #0f172a; color: #fff; }
.ed-btn.primary:hover { background: #1e293b; color: #fff; }
.ed-btn.primary.reserve { background: #1d4ed8; border-color: #1d4ed8; }

/* ---- 登録の確認 ---- */
.ecf-modal .modal-dialog { width: 460px; max-width: 94%; }
.ecf-modal .modal-content { border-radius: 12px; }
.ecf-modal .modal-title { font-size: 16px; font-weight: 700; color: #1e293b; }
.ecf-reg { font-family: Consolas, monospace; font-size: 20px; font-weight: 700; color: #0f172a; margin-bottom: 10px; }
.ecf-state { display: flex; align-items: center; gap: 8px; padding: 10px 12px; border-radius: 8px; margin-bottom: 12px; border: 1px solid #e2e8f0; background: #f8fafc; }
.ecf-state.keep { border-color: #a7f3d0; background: #ecfdf5; }
.ecf-state.drop { border-color: #fde68a; background: #fffbeb; }
.ecf-state.reserve { border-color: #bfdbfe; background: #eff6ff; }
.ecf-badge { font-size: 11px; font-weight: 700; padding: 3px 9px; border-radius: 4px; white-space: nowrap; }
.ecf-state.keep .ecf-badge { background: #dcfce7; color: #166534; }
.ecf-state.drop .ecf-badge { background: #fef3c7; color: #92400e; }
.ecf-state.new .ecf-badge, .ecf-state.reserve .ecf-badge { background: #dbeafe; color: #1d4ed8; }
.ecf-msg { font-size: 13px; font-weight: 600; color: #334155; line-height: 1.6; }
.ecf-note { font-size: 12px; color: #94a3b8; line-height: 1.7; }
.ecf-changes { margin: 0 0 10px; padding: 0; list-style: none; font-size: 12px; color: #475569; }
.ecf-changes li { padding: 2px 0; }
.ecf-changes li::before { content: "● "; color: #f59e0b; }
.ecf-btn { display: inline-flex; align-items: center; padding: 8px 18px; border-radius: 8px; border: 1px solid #cbd5e1; background: #fff; color: #334155; font-size: 14px; font-weight: 600; cursor: pointer; }
.ecf-btn:hover { background: #f1f5f9; }
.ecf-btn.primary { background: #0f172a; border-color: #0f172a; color: #fff; }
.ecf-btn.primary:hover { background: #1e293b; }

/* タブレット: 項目を2列にする */
@@media (min-width: 600px) {
    .ed-fields { grid-template-columns: 1fr 1fr; }
}
/* PC: カードを2列にする。左に機体そのもの、右に運用と保存の設定 */
@@media (min-width: 992px) {
    .ed-cards { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: start; }
    .ed-col { display: grid; gap: 14px; min-width: 0; }
}
/* スマホ: 見出しの操作は横に流し、入力はiOSが拡大しない16pxにする */
@@media (max-width: 599px) {
    .ed-reg { font-size: 26px; }
    .ed-links { width: 100%; }
    .ed-link { flex: 1 1 auto; justify-content: center; }
    .ed-input { font-size: 16px; }
    .ed-btn { padding: 0 14px; }
    .ed-btn.primary { min-width: 0; flex: 0 0 auto; }
}
</style>
}

<div class="ed-page">
    @* ---- 見出し ---- *@
    <div class="ed-head">
        <div class="ed-title">
            @if (Model.IsNew)
            {
                <h1 class="ed-reg new">✈ 新規登録@(string.IsNullOrEmpty(reg) ? "" : $"（{reg}）")</h1>
            }
            else
            {
                <h1 class="ed-reg">@reg</h1>
                <div class="ed-chips">
                    @if (airlineName != null) { <span class="ed-chip">@airlineName</span> }
                    @if (typeDetailName != null) { <span class="ed-chip">@typeDetailName</span> }
                    @if (operationName != null) { <span class="ed-chip">@operationName</span> }
                    @if (!string.IsNullOrEmpty(Model.Aircraft?.SpecialLivery)) { <span class="ed-chip livery">🎨 @Model.Aircraft.SpecialLivery</span> }
                </div>
            }
        </div>
        @if (!Model.IsNew)
        {
            <div class="ed-links">
                <a class="ed-link" href="/AD/@reg?fromAdmin=@fromAdmin" target="_blank" rel="noopener">🔍 詳細</a>
                @* 間違った内容で積まれた履歴を直しに行くための入口 *@
                <a class="ed-link" href="/AircraftHistory?reg=@reg&fromAdmin=@fromAdmin">🕘 更新履歴</a>
                <button type="button" class="ed-link" id="copy" data-copy-text="@Model.LinkPage" title="詳細ページのURLをコピー">📋 リンク</button>
                <a class="ed-link" href="https://twitter.com/intent/tweet?text=@(reg)%0a@(Model.LinkPage)" target="_blank" rel="noopener">𝕏 投稿</a>
            </div>
        }
    </div>
    @Html.HiddenFor(model => model.LinkPage)

    @* ---- お知らせ ---- *@
    @if (Model.ex != null)
    {
        <div class="ed-alert ng">⚠ 保存できませんでした。<pre>@Model.ex.ToString()</pre></div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="ed-alert ng">⚠ @Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="ed-alert ok">✔ @Model.Message</div>
    }

    @* ---- 予約中の更新。反映日が来たら日次ジョブが入れる。ここで直す内容とぶつからないか見られるように出す ---- *@
    @if (Model.Reservations.Count > 0)
    {
        <div class="ed-rsv">
            <div class="ed-rsv-title">
                📅 予約中の更新（@Model.Reservations.Count 件）
                <a href="/AircraftReservation?reg=@reg&fromAdmin=@fromAdmin">予約の一覧</a>
            </div>
            @foreach (var r in Model.Reservations)
            {
                <div class="ed-rsv-row">
                    <span class="ed-rsv-date">@r.ApplyDate.ToString("yyyy/MM/dd")</span>
                    <span class="ed-rsv-body">
                        @foreach (var c in r.Changes)
                        {
                            <span><b>@c.FieldName</b> @c.Before → <b>@c.After</b></span>
                        }
                        <span class="ed-rsv-src">@r.Source@(r.WriteHistory ? "" : "・履歴を作成しない")</span>
                    </span>
                    <form method="post" asp-controller="AircraftReservation" asp-action="Cancel">
                        <input type="hidden" name="reservationId" value="@r.ReservationId" />
                        <input type="hidden" name="reg" value="@reg" />
                        <input type="hidden" name="fromAdmin" value="@fromAdmin" />
                        <input type="hidden" name="returnTo" value="E" />
                        <button type="submit" class="ed-link"
                                onclick="return confirm('この予約を取り消します。機体情報は変わりません。よろしいですか？');">取消</button>
                    </form>
                </div>
            }
        </div>
    }

    <form asp-action="Store" method="post" id="editForm" autocomplete="off">
        <div class="ed-cards">
            <div class="ed-col">
                @* ---- 機体 ---- *@
                <section class="ed-card">
                    <h2 class="ed-card-title">✈ 機体</h2>
                    <div class="ed-fields">
                        <div class="ed-field">
                            @Html.LabelFor(model => model.Aircraft!.RegistrationNumber)
                            @if (Model.IsNew)
                            {
                                @Html.TextBoxFor(model => model.Aircraft!.RegistrationNumber, new { @class = "ed-input mono", placeholder = "JA01XX", style = "text-transform:uppercase" })
                            }
                            else
                            {
                                @* レジは主キーなので既存の機体では変えられない（変えると別の機体の更新になって失敗する） *@
                                @Html.TextBoxFor(model => model.Aircraft!.RegistrationNumber, new { @class = "ed-input mono", @readonly = "readonly" })
                            }
                        </div>
                        <div class="ed-field">
                            @Html.LabelFor(model => model.AirlineList, new { @for = "Aircraft_Airline" })
                            @Html.DropDownListFor(model => model.Aircraft!.Airline,
                                new SelectList(Model.AirlineList, "AirlineCode", "AirlineNameJpShort"), "　", new { @class = "ed-input" })
                        </div>
                        <div class="ed-field wide" data-track="Aircraft_TypeDetailId">
                            <span class="ed-label">@Html.DisplayNameFor(model => model.TypeDetailList)</span>
                            @* 詳細型式が増えて1つのセレクトでは探しづらいので、型式で絞ってから選ぶ *@
                            @await Html.PartialAsync("_TypeDetailPicker", typeDetailPicker)
                        </div>
                        <div class="ed-field">
                            @Html.LabelFor(model => model.Aircraft!.SerialNumber)
                            @Html.TextBoxFor(model => model.Aircraft!.SerialNumber, new { @class = "ed-input mono" })
                        </div>
                        @* 登録年月日・抹消年月日は日付で持つ（月までの登録はできない）。カレンダーから選べる *@
                        <div class="ed-field">
                            @Html.LabelFor(model => model.Aircraft!.RegisterDate)
                            @Html.TextBoxFor(model => model.Aircraft!.RegisterDate, "{0:yyyy-MM-dd}", new { @class = "ed-input mono", type = "date" })
                        </div>
                        <div class="ed-field">
                            @Html.LabelFor(model => model.Aircraft!.DeregisterDate)
                            @Html.TextBoxFor(model => model.Aircraft!.DeregisterDate, "{0:yyyy-MM-dd}", new { @class = "ed-input mono", type = "date" })
                        </div>
                    </div>
                </section>

                @* ---- 運用 ---- *@
                <section class="ed-card">
                    <h2 class="ed-card-title">🛫 運用</h2>
                    <div class="ed-fields">
                        <div class="ed-field">
                            @Html.LabelFor(model => model.OperationList, new { @for = "Aircraft_OperationCode" })
                            @Html.DropDownListFor(model => model.Aircraft!.OperationCode,
                                new SelectList(Model.OperationList, "Key", "Value"), "　", new { @class = "ed-input" })
                        </div>
                        <div class="ed-field">
                            @Html.LabelFor(model => model.WiFiList, new { @for = "Aircraft_WifiCode" })
                            @Html.DropDownListFor(model => model.Aircraft!.WifiCode,
                                new SelectList(Model.WiFiList, "Key", "Value"), "　", new { @class = "ed-input" })
                        </div>
                        <div class="ed-field wide">
                            @Html.LabelFor(model => model.Aircraft!.SeatConfig)
                            <div class="ed-with-add">
                                @Html.DropDownListFor(model => model.Aircraft!.SeatConfig,
                                    new SelectList(Model.SeatConfigurationList, "ConfigId", "SeatConfigLong"), "　", new { @class = "ed-input" })
                                @* マスタに無いコンフィグに出くわしたとき、この画面を離れずに足せるようにする *@
                                <partial name="_SeatConfigQuickAdd" model="seatConfigQuickAdd" />
                            </div>
                            <div class="ed-hint">航空会社と詳細型式に合うものだけが出ます。</div>
                        </div>
                        <div class="ed-field wide">
                            @Html.LabelFor(model => model.Aircraft!.SpecialLivery)
                            @Html.TextBoxFor(model => model.Aircraft!.SpecialLivery, new { @class = "ed-input", placeholder = "通常塗装なら空欄" })
                        </div>
                        <div class="ed-field">
                            @Html.LabelFor(model => model.Aircraft!.TestRegistration)
                            @Html.TextBoxFor(model => model.Aircraft!.TestRegistration, new { @class = "ed-input mono" })
                            <div class="ed-hint">デリバリー後（受領前以外の運用状況）に保存すると消えます。</div>
                        </div>
                        <div class="ed-field">
                            <label for="Aircraft_MaintenanceNotify">@Html.DisplayNameFor(model => model.Aircraft!.MaintenanceNotify)</label>
                            <select class="ed-input" id="Aircraft_MaintenanceNotify" name="Aircraft.MaintenanceNotify">
                                <option value="" selected="@(maintenance == null)">未設定</option>
                                <option value="true" selected="@(maintenance == true)">あり</option>
                                <option value="false" selected="@(maintenance == false)">なし</option>
                            </select>
                        </div>
                    </div>
                </section>
            </div>

            <div class="ed-col">
                @* ---- メモ ---- *@
                <section class="ed-card">
                    <h2 class="ed-card-title">📝 備考・リンク</h2>
                    <div class="ed-fields">
                        <div class="ed-field wide">
                            @Html.LabelFor(model => model.Aircraft!.Remarks)
                            @Html.TextBoxFor(model => model.Aircraft!.Remarks, new { @class = "ed-input" })
                        </div>
                        <div class="ed-field wide">
                            @Html.LabelFor(model => model.Aircraft!.LinkUrl)
                            @Html.TextAreaFor(model => model.Aircraft!.LinkUrl, new { @class = "ed-input mono", rows = 3 })
                        </div>
                    </div>
                </section>

                @* ---- 保存のしかた ---- *@
                <section class="ed-card">
                    <h2 class="ed-card-title">💾 保存のしかた</h2>
                    <div class="ed-fields">
                        @if (!Model.IsNew)
                        {
                            <div class="ed-field wide" data-notrack="true">
                                <label class="ed-check" id="notUpdateBox">
                                    @Html.CheckBoxFor(model => model.NotUpdateDate)
                                    <span>
                                        @Html.DisplayNameFor(model => model.NotUpdateDate)
                                        <span class="ed-hint" style="display:block">入れると更新前の内容を更新履歴に残さず、更新日時も進めません（誤記の修正など）。</span>
                                    </span>
                                </label>
                            </div>
                            <div class="ed-field wide">
                                <label for="ReserveDate">@Html.DisplayNameFor(model => model.ReserveDate)（任意）</label>
                                <input type="date" name="ReserveDate" id="ReserveDate" class="ed-input"
                                       min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" value="" />
                                <div class="ed-hint">入れるといまは更新せず、この日に変えた項目だけを反映します（特別塗装・運航の開始日が決まっているとき用）。</div>
                            </div>
                        }
                        else
                        {
                            @* 新規登録では履歴は積まれない。値だけ持ち回る *@
                            @Html.HiddenFor(model => model.NotUpdateDate)
                            <div class="ed-field wide ed-hint">新規登録では更新履歴は積まれません。予約は登録したあとから使えます。</div>
                        }
                    </div>

                    @* 作成日時・実更新日時は送らないと保存で消えてしまうので、読み取り専用で持つ *@
                    <div class="ed-times">
                        <div class="ed-field">
                            @Html.LabelFor(model => model.Aircraft!.UpdateTime)
                            @Html.TextBoxFor(model => model.Aircraft!.UpdateTime, new { @class = "ed-input mono" })
                        </div>
                        <div class="ed-field">
                            @Html.LabelFor(model => model.Aircraft!.CreationTime)
                            @Html.TextBoxFor(model => model.Aircraft!.CreationTime, new { @class = "ed-input mono", @readonly = "readonly" })
                        </div>
                        <div class="ed-field">
                            @Html.LabelFor(model => model.Aircraft!.ActualUpdateTime)
                            @Html.TextBoxFor(model => model.Aircraft!.ActualUpdateTime, new { @class = "ed-input mono", @readonly = "readonly" })
                        </div>
                    </div>
                </section>
            </div>
        </div>

        @Html.HiddenFor(model => model.IsNew)
        @Html.HiddenFor(model => model.NoHead)
        @Html.HiddenFor(model => model.FromAdmin)

        @* ---- 下の操作バー。長い画面でもスクロールせずに登録できるよう常に出す ---- *@
        <div class="ed-bar">
            <div class="ed-bar-in">
                <button type="button" class="ed-btn" onclick="history.back();">戻る</button>
                <div class="ed-bar-state" id="barState">変更はありません</div>
                <button type="submit" class="ed-btn primary" id="store">登録</button>
            </div>
        </div>
    </form>
</div>

@*
    登録の確認。履歴を残すか残さないかは後から気づきにくいので、どちらでも必ず出す。
    中身は押した時点の「履歴を作成しない」「予約日」の状態でJSから差し替える。
*@
<div class="modal fade ecf-modal" id="storeConfirm" tabindex="-1" role="dialog" aria-labelledby="storeConfirmTitle">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="閉じる"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="storeConfirmTitle">登録の確認</h4>
            </div>
            <div class="modal-body">
                <div class="ecf-reg">@(Model.IsNew ? "新規登録" : reg)</div>
                <ul class="ecf-changes"></ul>
                <div class="ecf-state">
                    <span class="ecf-badge"></span>
                    <span class="ecf-msg"></span>
                </div>
                <div class="ecf-note"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="ecf-btn" data-dismiss="modal">キャンセル</button>
                <button type="button" class="ecf-btn primary" id="storeConfirmOk">登録する</button>
            </div>
        </div>
    </div>
</div>

@section ScriptsPartial{
    <partial name="_TypeDetailPickerScript" />
    <partial name="_SeatConfigQuickAddScript" />
    <script>
        JfDom.ready(function () {
            const byId = function (id) { return document.getElementById(id); };

            // ---- 共通レイアウトのナビバーは固定表示で、タブレット幅だと折り返して2〜3段になり見出しを隠す。
            //      bodyの余白（site.cssの64px）より高くなったときだけ、余白をナビバーの高さに合わせる ----
            const nav = document.querySelector('.navbar-fixed-top');
            const basePadding = parseFloat(getComputedStyle(document.body).paddingTop) || 0;
            const fitTop = function () {
                if (!nav || nav.querySelector('.navbar-collapse.in')) { return; }
                document.body.style.paddingTop = Math.max(basePadding, nav.offsetHeight + 8) + 'px';
            };
            fitTop();
            window.addEventListener('resize', fitTop);

            const isNew = @(Model.IsNew.ToString().ToLowerInvariant());
            const form = byId('editForm');
            const storeConfirm = byId('storeConfirm');
            const storeConfirmOk = byId('storeConfirmOk');
            const copyButton = byId('copy');

            // ---- リンクのコピー ----
            // ブラウザ標準の Clipboard API（https と localhost で使える）で書き込む。アプリ内ブラウザなどで
            // 書き込みを拒否されたときは、以前の clipboard.js と同じ execCommand('copy') で写す
            const copyByCommand = function (text) {
                const ta = document.createElement('textarea');
                ta.readOnly = true;
                ta.value = text;
                Object.assign(ta.style, { position: 'fixed', top: '0', left: '0', opacity: '0' });
                document.body.appendChild(ta);
                ta.select();
                let ok = false;
                try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
                ta.remove();
                return ok ? Promise.resolve() : Promise.reject();
            };
            const copyLink = function () {
                const text = copyButton ? (copyButton.getAttribute('data-copy-text') || '') : '';
                if (!text) { return Promise.reject(); }
                if (!navigator.clipboard) { return copyByCommand(text); }
                return navigator.clipboard.writeText(text).catch(function () { return copyByCommand(text); });
            };
            const flashCopy = function (label) {
                const original = copyButton.dataset.label || copyButton.textContent;
                copyButton.dataset.label = original;
                copyButton.textContent = label;
                setTimeout(function () { copyButton.textContent = original; }, 1500);
            };
            if (copyButton) {
                copyButton.addEventListener('click', function () {
                    copyLink().then(function () { flashCopy('✔ コピーしました'); }, function () { flashCopy('コピーできませんでした'); });
                });
            }

            // ---- 変えた項目に印を付ける ----
            // 開いたときの値と比べる。保存前にどこを触ったかを見失わないようにするため。
            const valueOf = function (el) {
                return el.type === 'checkbox' ? String(el.checked) : (el.value || '');
            };
            const tracked = [];
            form.querySelectorAll('.ed-field').forEach(function (field) {
                if (field.getAttribute('data-notrack')) { return; }
                const trackId = field.getAttribute('data-track');
                const input = trackId
                    ? byId(trackId)
                    : field.querySelector('input:not([type=hidden]):not([readonly]):not([id=ReserveDate]), select:not([id=ReserveDate]), textarea:not([id=ReserveDate])');
                if (!input) { return; }
                const labelEl = field.querySelector(':scope > label, :scope > .ed-label');
                const label = ((labelEl && labelEl.textContent) || '').trim();
                tracked.push({ field: field, input: input, label: label, initial: valueOf(input) });
            });

            const changedLabels = function () {
                return tracked.filter(function (t) { return valueOf(t.input) !== t.initial; }).map(function (t) { return t.label; });
            };

            const reserveDateValue = function () { const r = byId('ReserveDate'); return r ? r.value : ''; };
            const notUpdateChecked = function () { const n = byId('NotUpdateDate'); return !!(n && n.checked); };

            const refresh = function () {
                let count = 0;
                tracked.forEach(function (t) {
                    const dirty = valueOf(t.input) !== t.initial;
                    t.field.classList.toggle('dirty', dirty);
                    if (dirty) { count++; }
                });

                const reserveDate = reserveDateValue();
                const notUpdate = notUpdateChecked();
                const notUpdateBox = byId('notUpdateBox');
                if (notUpdateBox) { notUpdateBox.classList.toggle('on', notUpdate); }

                const parts = [];
                if (count > 0) { parts.push('<b>' + count + '項目</b>を変更'); } else { parts.push('変更はありません'); }
                if (reserveDate && !isNew) { parts.push('<span class="rsv">📅 ' + reserveDate.replace(/-/g, '/') + ' に予約</span>'); }
                else if (notUpdate && !isNew) { parts.push('履歴を作成しない'); }
                byId('barState').innerHTML = parts.join('<br>');

                const store = byId('store');
                store.textContent = reserveDate && !isNew ? '予約する' : '登録';
                store.classList.toggle('reserve', !!reserveDate && !isNew);
            };
            const onFieldChange = function (e) {
                if (e.target.matches && e.target.matches('input, select, textarea')) { refresh(); }
            };
            form.addEventListener('input', onFieldChange);
            form.addEventListener('change', onFieldChange);
            refresh();

            // ---- 登録の前に確認する。履歴を残すか残さないかは後から気づきにくいので、どちらでも必ず出す ----
            const setText = function (selector, text) { storeConfirm.querySelector(selector).textContent = text; };
            byId('store').addEventListener('click', function (e) {
                e.preventDefault();

                const notUpdate = notUpdateChecked();
                const reserveDate = reserveDateValue();
                const box = storeConfirm.querySelector('.ecf-state');
                const labels = changedLabels();

                const list = storeConfirm.querySelector('.ecf-changes');
                const item = function (text) { const li = document.createElement('li'); li.textContent = text; return li; };
                list.replaceChildren.apply(list, labels.map(item));
                if (!isNew && labels.length === 0) { list.appendChild(item('変えた項目はありません')); }

                box.classList.remove('new', 'keep', 'drop', 'reserve');
                storeConfirmOk.textContent = reserveDate && !isNew ? '予約する' : '登録する';
                if (reserveDate && !isNew) {
                    box.classList.add('reserve');
                    setText('.ecf-badge', '予約');
                    setText('.ecf-msg', reserveDate.replace(/-/g, '/') + ' に反映するよう予約します。いまの機体情報は変わりません。');
                    setText('.ecf-note', 'いまの内容から変えた項目だけを予約します。反映するときに'
                        + (notUpdate ? '更新履歴は残しません（「履歴を作成しない」にチェックあり）。' : '更新前の内容を更新履歴に残します。'));
                } else if (isNew) {
                    box.classList.add('new');
                    setText('.ecf-badge', '新規登録');
                    setText('.ecf-msg', 'このレジを新しく登録します。');
                    setText('.ecf-note', '新規登録では更新履歴は積まれません。');
                } else if (notUpdate) {
                    box.classList.add('drop');
                    setText('.ecf-badge', '履歴を残さない');
                    setText('.ecf-msg', '更新履歴を残さずに、いまの内容を上書きします。');
                    setText('.ecf-note', '「履歴を作成しない」にチェックが入っています。上書き前の内容は残りません。');
                } else {
                    box.classList.add('keep');
                    setText('.ecf-badge', '履歴を残す');
                    setText('.ecf-msg', 'いまの内容を更新履歴に残してから登録します。');
                    setText('.ecf-note', '「履歴を作成しない」のチェックが外れています。機体詳細の履歴に1件増えます。');
                }

                JfUi.modal.show(storeConfirm);
            });

            storeConfirm.addEventListener('jf:modal-shown', function () { storeConfirmOk.focus(); });

            storeConfirmOk.addEventListener('click', function () {
                JfUi.modal.hide(storeConfirm);
                //登録するときだけ詳細ページのURLをクリップボードへ入れる（以前と同じ）。
                //書き込みは非同期なので、終わってから（失敗しても）送る。返事が来ないときも 1 秒で送る
                let submitted = false;
                const submit = function () { if (!submitted) { submitted = true; form.submit(); } };
                const copying = copyButton ? copyLink() : Promise.resolve();
                copying.then(submit, submit);
                setTimeout(submit, 1000);
            });

            // ---- コンフィグの選択肢は航空会社と詳細型式で絞る ----
            const recreateSeatConfigList = function () {
                JfHttp.get('/Master/SeatConfiguration/?airline=' + byId('Aircraft_Airline').value + '&typeDetailId=' + byId('Aircraft_TypeDetailId').value).then(function (data) {
                    const select = byId('Aircraft_SeatConfig');
                    const current = select.value;
                    select.replaceChildren(new Option('', ''));
                    data.forEach(function (seatconfig) {
                        select.add(new Option(seatconfig.seatConfigLong, seatconfig.configId));
                    });
                    //絞り込み後も残っていれば選んだままにする
                    if (current && Array.from(select.options).some(function (o) { return o.value === current; })) { select.value = current; }
                    refresh();
                });
            };
            byId('Aircraft_TypeDetailId').addEventListener('change', recreateSeatConfigList);
            byId('Aircraft_Airline').addEventListener('change', recreateSeatConfigList);
        });
</script>
}
