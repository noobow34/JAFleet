@model JAFleet.Models.SiteSettingModel
@{
    Layout = "_LayoutNoHead";
    Model.Title = "サイト設定";
}

@section CssPartial {
<style>
/* ===== サイト設定 =====
   注意: Bootstrap3 が html{font-size:10px} を設定しているため
   このページでは 1rem = 10px になる。remは使わずpxで指定すること。 */
.set-page { padding: 16px 0 60px; max-width: 900px; }
.set-page h2 { margin: 0 0 4px; font-size: 22px; font-weight: 700; color: #1e293b; }
.set-lead { font-size: 13px; color: #94a3b8; margin-bottom: 18px; line-height: 1.7; }

.set-card {
    border: 1px solid #e2e8f0; border-radius: 10px; background: #fff;
    padding: 16px 18px; margin-bottom: 12px; box-shadow: 0 1px 4px rgba(0,0,0,.06);
}
.set-name { font-size: 15px; font-weight: 700; color: #1e293b; }
.set-desc { font-size: 13px; color: #64748b; margin-top: 4px; line-height: 1.7; }

.set-body {
    display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
    margin-top: 14px; padding-top: 14px; border-top: 1px dashed #e2e8f0;
}
.set-check {
    display: flex; align-items: center; gap: 6px; min-height: 34px; margin: 0;
    font-size: 14px; font-weight: 600; color: #334155; cursor: pointer;
}
.set-check input { width: 16px; height: 16px; margin: 0; }

.set-btn {
    display: inline-flex; align-items: center; height: 34px; padding: 0 18px;
    border-radius: 6px; border: 1px solid #cbd5e1; background: #fff; color: #334155;
    font-size: 14px; font-weight: 600; text-decoration: none; cursor: pointer;
}
.set-btn:hover { background: #f1f5f9; text-decoration: none; color: #1e293b; }
.set-btn.primary { background: #0f172a; border-color: #0f172a; color: #fff; margin-left: auto; }
.set-btn.primary:hover { background: #1e293b; color: #fff; }

.set-error {
    border: 1px solid #fecaca; background: #fef2f2; border-radius: 10px;
    padding: 12px 16px; margin-bottom: 16px; font-size: 13px; color: #b91c1c;
    font-weight: 600; line-height: 1.7; word-break: break-all;
}
.set-ok {
    border: 1px solid #a7f3d0; background: #ecfdf5; border-radius: 10px;
    padding: 12px 16px; margin-bottom: 16px; font-size: 14px; color: #065f46;
    font-weight: 700; line-height: 1.7;
}

@@media (max-width: 700px) {
    .set-btn.primary { margin-left: 0; width: 100%; justify-content: center; }
}
</style>
}

<div class="set-page">
    <h2>⚙ サイト設定</h2>
    <div class="set-lead">保存するとその場で反映されます。アプリの再起動は要りません。</div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="set-error">⚠ @Model.ErrorMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="set-ok">✔ @Model.Message</div>
    }

    <form class="set-card" method="post" asp-controller="SiteSetting" asp-action="Save">
        <input type="hidden" name="fromAdmin" value="@Model.FromAdmin.ToString().ToLowerInvariant()" />

        <div class="set-name">公開メニュー</div>
        <div class="set-desc">
            外しても <code>/NotWorkingInfo</code> のページ自体は開けます（管理コンソールの「非稼働情報」から）。<br />
            稼働状況の取得が止まっているあいだ、正しくない一覧を公開メニューから隠すのに使います。
        </div>

        <div class="set-body">
            <label class="set-check">
                <input type="checkbox" name="showNotWorkingInfoMenu" value="true" checked="@Model.ShowNotWorkingInfoMenu" />
                メニューに「非稼働情報」を表示する
            </label>
            <button type="submit" class="set-btn primary">保存</button>
        </div>
    </form>

    <div class="set-card">
        <div class="set-name">定期実行ジョブ</div>
        <div class="set-desc">各ジョブの有効・無効と実行時刻は、定期実行ジョブの画面で切り替えます。</div>
        <div class="set-body">
            <a class="set-btn" href="/Scheduler?fromAdmin=@Model.FromAdmin.ToString().ToLowerInvariant()">⏰ 定期実行ジョブを開く</a>
        </div>
    </div>
</div>
