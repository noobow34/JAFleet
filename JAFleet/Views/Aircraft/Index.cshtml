@model AircraftModel
@section HeadPartial{
    <meta name="description" content="@(Model.Title)の機材（飛行機）一覧ページです。JA-Fleetは日本国内の航空会社が保有する機材（飛行機）を一覧表示や検索できるサイトです。">
    <meta name="referrer" content="no-referrer" />

    <meta property="og:type" content="article" />
    <meta property="og:description" content="@(Model.Title)の機材（飛行機）一覧ページです。JA-Fleetは日本国内の航空会社が保有する機材（飛行機）を一覧表示や検索できるサイトです。" />
    <meta property="og:image" content="https://ja-fleet.noobow.me/images/JA-Fleet_1_og.png" />
    <meta property="og:url" content="https://ja-fleet.noobow.me/@Context.Request.Path" />
    <meta property="og:site_name" content="JA-Fleet【本邦航空会社機材一覧サイト】" />
    <meta content="summary" name="twitter:card" />
    <meta content="@@ja_fleet" name="twitter:site" />
}
@section CssPartial{
    <link rel="stylesheet" href="~/css/fleet-list.css" asp-append-version="true" />
}
<div class="fl-page-head">
    <h2 class="fl-page-title">@(Model.Title)</h2>
    <label class="fl-switch">
        @Html.CheckBoxFor(model => model.IncludeRetire)
        @Html.DisplayNameFor(model => model.IncludeRetire)
    </label>
    @if (Model.IsAllRetire)
    {
        <span class="fl-note">この機種は全機退役済です</span>
    }
</div>
<div id="fleetList"></div>
@section ScriptsPartial{
    <script src="~/js/fleet-list.js" asp-append-version="true"></script>
    <script>
        JfDom.ready(function () {
            const api = '@(Model.api)';
            const fleet = FleetList.create('#fleetList', { isAdmin: @(Model.IsAdmin ? "true" : "false") });
            const includeRetire = document.getElementById('IncludeRetire');

            const getIncludeRetire = function () {
                return includeRetire.checked;
            };
            const load = function () {
                fleet.load(JfHttp.get(api + '?includeRetire=' + getIncludeRetire()));
            };

            includeRetire.addEventListener('change', function () {
                history.pushState(null, null, "?includeRetire=" + getIncludeRetire());
                load();
            });

            load();
        });
    </script>
}
