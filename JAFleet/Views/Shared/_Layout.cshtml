@using JAFleet.Services;
@using JAFleet.Commons.Data;

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="google-site-verification" content="gaEmZmJrwC5Ay5P-0hcqz_IteB60VIJNDlIbfsSFlxo" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @RenderSection("HeadPartial", required: false)
    <title>@(Model.Title) - JA-Fleet【本邦航空会社機材一覧サイト】</title>
    <meta content="@(Model.Title) - JA-Fleet【本邦航空会社機材一覧サイト】" name="title">
    <meta property="og:title" content="@(Model.Title) - JA-Fleet【本邦航空会社機材一覧サイト】" />

    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.min.css" asp-append-version="true" />
    @RenderSection("CssPartial", required: false)
</head>

<body>
    <partial name="_SiteNav" />

    <div class="modal fade" id="lineinfo" tabindex="-1" data-loadtarget="@Url.Content("~/line.html")" data-loaded=""></div>
    <div class="modal fade" id="sendMessage" tabindex="-1" data-loadtarget="@Url.Content("~/message.html")" data-loaded=""></div>
    <div class="modal fade" id="donate" tabindex="-1" data-loadtarget="@Url.Content("~/donate.html?q=20191231")" data-loaded=""></div>

    <div class="container">
        @{
            var backModel = Model as JAFleet.Models.BaseModel;
        }
        @if (backModel is { FromAdmin: true })
        {
            @await Html.PartialAsync("_BackToAdmin", backModel)
        }
        @RenderBody()
    </div>

    <script src="~/js/site.min.js" asp-append-version="true"></script>
    <script>
        (function () {
            // ナビバーのメニュー（スマホ・タブレット）: 開いているあいだは本文を暗くしてスクロールを止め、外を押したら閉じる
            const menu = document.getElementById('jfMenu');
            menu.addEventListener('jf:collapse-show', function () { document.body.classList.add('jf-menu-open'); });
            menu.addEventListener('jf:collapse-hide', function () { document.body.classList.remove('jf-menu-open'); });
            document.getElementById('jfBackdrop').addEventListener('click', function () { JfUi.collapse.hide(menu); });
            // メニューからお問い合わせ・LINE を開いたときはメニューを閉じる
            menu.querySelectorAll('[data-toggle="modal"]').forEach(function (a) {
                a.addEventListener('click', function () { JfUi.collapse.hide(menu); });
            });

            // LINE・お問い合わせ・寄付のモーダルは、初めて開くときに中身を読み込む
            document.addEventListener('jf:modal-show', function (e) {
                const modal = e.target;
                const id = modal.id;
                if (modal.dataset.loadtarget && modal.dataset.loaded === '') {
                    modal.dataset.loaded = 'loading';
                    fetch(modal.dataset.loadtarget)
                        .then(function (res) { return res.text(); })
                        .then(function (html) {
                            modal.innerHTML = html;
                            if (id === 'sendMessage') {
                                document.getElementById('sendButton').addEventListener('click', function () { sendMessageToMe(); });
                            }
                            if (id === 'donate') {
                                document.getElementById('mlbl').textContent = ZGB();
                            }
                            modal.dataset.loaded = '1';
                        })
                        .catch(function () { modal.dataset.loaded = ''; });
                }
                if (id === 'sendMessage') {
                    const result = document.getElementById('result');
                    if (result) { result.textContent = ''; }
                }
            });
        })();
    </script>
    @RenderSection("ScriptsPartial", required: false)

</body>
</html>
