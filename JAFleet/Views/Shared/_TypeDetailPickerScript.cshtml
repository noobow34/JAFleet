@*
    _TypeDetailPicker.cshtml を動かすスクリプト。
    site.min.js（JfUi / JfHttp / JfDom）は_Layoutの末尾で読み込まれるので、画面側の @@section ScriptsPartial の中に置くこと。
    画面内のピッカーは全部まとめて初期化するので、画面側から呼ぶものは無い。
*@
<script>
    JfDom.ready(function () {
        document.querySelectorAll('.tdp-modal').forEach(function (modal) {
            const field = document.getElementById(modal.getAttribute('data-tdp-field'));
            //ピッカーのボタンとモーダルは対になっている。同じ画面に複数あっても取り違えない。
            const openers = document.querySelectorAll('[data-tdp-open="' + modal.id + '"]');

            const find = function (selector) { return modal.querySelector(selector); };
            const findAll = function (selector) { return Array.from(modal.querySelectorAll(selector)); };
            const search = find('.tdp-search');
            const empty = find('.tdp-empty');
            const error = find('.tdp-detail-error');
            const typeError = find('.tdp-newtype-error');
            const newType = find('.tdp-new-type');

            //詳細型式も型式も新規登録で後から増える。取り違えないよう毎回引き直して使う。
            const details = function () { return findAll('.tdp-detail'); };
            const types = function () { return findAll('.tdp-type'); };
            const currentTypeCode = function () {
                const on = types().filter(function (t) { return t.classList.contains('on'); })[0];
                return (on && on.getAttribute('data-type')) || '';
            };

            const showError = function (el, text) { el.textContent = text; JfDom.show(el); };
            const clearError = function (el) { JfDom.hide(el); el.textContent = ''; };

            //この部品はフォームの中に置かれる。中に入力欄があるとEnterでフォームが送信されてしまうので、
            //初期化のときにフォームの外（body直下）へ出しておく。
            document.body.appendChild(modal);

            // ---- 一覧の絞り込み ----
            // 検索語があるときは型式をまたいで探す。型式の選択より検索を優先する。
            const refresh = function () {
                const keyword = (search.value || '').trim().toLowerCase();
                const typeCode = currentTypeCode();
                let shown = 0;

                details().forEach(function (button) {
                    const nameMatched = keyword === '' ||
                        (button.getAttribute('data-name') || '').toLowerCase().indexOf(keyword) >= 0;
                    const typeMatched = keyword !== '' || typeCode === '' ||
                        (button.getAttribute('data-type') || '') === typeCode;
                    const visible = nameMatched && typeMatched;

                    JfDom.toggle(button.parentElement, visible);
                    if (visible) { shown++; }
                });

                JfDom.toggle(empty, shown === 0);
            };

            search.addEventListener('input', refresh);

            // ---- 選ぶ ----
            const select = function (id, name) {
                field.value = id;
                openers.forEach(function (opener) {
                    const value = opener.querySelector('.tdp-value');
                    value.textContent = name;
                    value.classList.remove('empty');
                });

                details().forEach(function (d) { d.classList.toggle('cur', d.getAttribute('data-id') === id); });

                //セレクトだった頃と同じようにchangeを見ている処理があるので飛ばす
                JfDom.trigger(field, 'change');
                JfUi.modal.hide(modal);
            };

            // 型式の選択と詳細型式の選択は、後から足したボタンにも効くようモーダルで受ける
            modal.addEventListener('click', function (e) {
                const type = e.target.closest('.tdp-type');
                if (type) {
                    types().forEach(function (t) { t.classList.remove('on'); });
                    type.classList.add('on');
                    //型式を選び直したら検索語は邪魔になるので消す
                    search.value = '';
                    refresh();
                    return;
                }
                const detail = e.target.closest('.tdp-detail');
                if (detail) {
                    select(detail.getAttribute('data-id'), detail.getAttribute('data-name'));
                }
            });

            // ---- 選ぶ / 詳細型式の新規登録 / 型式の新規登録 の切り替え ----
            const titles = {
                select: '詳細型式を選ぶ',
                new: '詳細型式の新規登録',
                newtype: '型式の新規登録'
            };

            const showPage = function (page) {
                JfDom.toggle(modal.querySelectorAll('.tdp-page-select'), page === 'select');
                JfDom.toggle(modal.querySelectorAll('.tdp-page-new'), page === 'new');
                JfDom.toggle(modal.querySelectorAll('.tdp-page-newtype'), page === 'newtype');
                find('.tdp-title').textContent = titles[page];
            };

            find('.tdp-to-new').addEventListener('click', function () {
                clearError(error);
                //探していた語をそのまま名前の下書きにする
                find('.tdp-new-name').value = search.value || '';
                find('.tdp-new-code').value = '';
                newType.value = currentTypeCode();
                showPage('new');
            });

            find('.tdp-to-select').addEventListener('click', function () { showPage('select'); });

            //詳細型式の入力は消さずに残す。型式を足したら続きを入れてもらう。
            find('.tdp-to-newtype').addEventListener('click', function () {
                clearError(typeError);
                find('.tdp-newtype-code').value = '';
                find('.tdp-newtype-name').value = '';
                find('.tdp-newtype-maker').value = '';
                find('.tdp-newtype-order').value = '';
                showPage('newtype');
            });

            find('.tdp-newtype-back').addEventListener('click', function () { showPage('new'); });

            const submitOnEnter = function (inputs, submitSelector) {
                inputs.forEach(function (input) {
                    input.addEventListener('keydown', function (e) {
                        if (e.key === 'Enter') {
                            e.preventDefault();
                            find(submitSelector).click();
                        }
                    });
                });
            };
            submitOnEnter(findAll('.tdp-new-name, .tdp-new-code'), '.tdp-new-submit');

            openers.forEach(function (opener) {
                opener.addEventListener('click', function () {
                    showPage('select');
                    refresh();
                    JfUi.modal.show(modal);
                });
            });

            const li = function (child) {
                const item = document.createElement('li');
                item.appendChild(child);
                return item;
            };
            const button = function (className, attrs, spans) {
                const b = document.createElement('button');
                b.type = 'button';
                b.className = className;
                Object.keys(attrs).forEach(function (k) { b.setAttribute(k, attrs[k]); });
                spans.forEach(function (s) {
                    const span = document.createElement('span');
                    span.className = s[0];
                    span.textContent = s[1];
                    b.appendChild(span);
                });
                return b;
            };

            // ---- 新規登録 ----
            const newSubmit = find('.tdp-new-submit');
            newSubmit.addEventListener('click', function () {
                newSubmit.disabled = true;

                JfHttp.post('/Master/CreateTypeDetail', {
                    typeCode: newType.value,
                    typeDetailCode: find('.tdp-new-code').value,
                    typeDetailName: find('.tdp-new-name').value
                }).then(function (data) {
                    if (data.error) {
                        showError(error, data.error);
                        return;
                    }

                    const typeCode = newType.value || '';
                    const typeName = newType.selectedOptions[0] ? newType.selectedOptions[0].text : '';
                    const id = String(data.id);

                    //登録したものを一覧にも足す。閉じて開き直しても選べる。
                    if (!details().some(function (d) { return d.getAttribute('data-id') === id; })) {
                        find('.tdp-details').appendChild(li(button('tdp-detail',
                            { 'data-id': id, 'data-type': typeCode, 'data-name': data.name },
                            [['nm', data.name], ['tp', typeName]])));
                    }

                    //型式ごと新規登録した直後は左の一覧に出ていない（詳細型式が0件の型式は出していないため）。
                    //これで絞り込みからも辿れる。
                    if (typeCode !== '' && !types().some(function (t) { return t.getAttribute('data-type') === typeCode; })) {
                        find('.tdp-types').appendChild(li(button('tdp-type',
                            { 'data-type': typeCode },
                            [['nm', typeName], ['cnt', '1']])));
                    }

                    search.value = '';
                    showPage('select');
                    select(id, data.name);
                }, function (xhr) {
                    showError(error, '登録に失敗しました (' + xhr.status + ' ' + xhr.statusText + ')');
                }).then(function () {
                    newSubmit.disabled = false;
                });
            });

            // ---- 型式の新規登録 ----
            submitOnEnter(findAll('.tdp-newtype-code, .tdp-newtype-name, .tdp-newtype-order'), '.tdp-newtype-submit');

            const newTypeSubmit = find('.tdp-newtype-submit');
            newTypeSubmit.addEventListener('click', function () {
                newTypeSubmit.disabled = true;

                JfHttp.post('/Master/CreateType', {
                    typeCode: find('.tdp-newtype-code').value,
                    typeName: find('.tdp-newtype-name').value,
                    makerCode: find('.tdp-newtype-maker').value,
                    displayOrder: find('.tdp-newtype-order').value
                }).then(function (data) {
                    if (data.error) {
                        showError(typeError, data.error);
                        return;
                    }

                    //登録した型式を詳細型式側の選択肢に足して選ばせる。
                    //同じ画面に複数のピッカーがあっても、開いているモーダルの分だけ足せば用は足りる
                    //（この画面を保存したあとは読み直されるため）。
                    const code = String(data.code);
                    if (!Array.from(newType.options).some(function (o) { return o.value === code; })) {
                        newType.add(new Option(data.name, code));
                    }
                    newType.value = code;

                    showPage('new');
                }, function (xhr) {
                    showError(typeError, '登録に失敗しました (' + xhr.status + ' ' + xhr.statusText + ')');
                }).then(function () {
                    newTypeSubmit.disabled = false;
                });
            });

            refresh();
        });
    });
</script>
