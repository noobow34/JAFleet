@*
    _BusyOverlay.cshtml を動かすスクリプト。
    site.min.js（JfDom など）は_Layoutの末尾で読み込まれるので、画面側の @@section ScriptsPartial の中に置くこと。

    data-busy を持つ要素を押したらぐるぐるを出す。あとから差し込まれる部分ビュー
    （Gmailのメール一覧）の中のボタンにも効かせるため、documentに委譲して拾う。
*@
<script>
    JfDom.ready(function () {
        const overlay = document.getElementById('busyOverlay');

        document.addEventListener('click', function (e) {
            const target = e.target.closest('[data-busy]');
            if (!target) { return; }
            document.getElementById('busyText').textContent = target.getAttribute('data-busy') || '処理しています…';
            overlay.hidden = false;
        });

        //ブラウザの戻るで表示された場合、覆ったままだと操作できなくなるので必ず消す
        window.addEventListener('pageshow', function () {
            overlay.hidden = true;
        });
    });
</script>
