@*
    _SeatConfigQuickAdd.cshtml を動かすスクリプト。
    jQueryは_Layoutの末尾で読み込まれるので、画面側の @@section ScriptsPartial の中に置くこと。
    画面内のその場登録は全部まとめて初期化するので、画面側から呼ぶものは無い。

    詳細型式IDは数字だけのことがあり、jQueryの.data()は数値に変換してしまう。
    比較がずれるので、読み取りには.attr()だけを使う。
*@
<script>
    $(function () {
        $('.scq-modal').each(function () {
            const modal = $(this);
            const opener = $('[data-scq-open="' + modal.attr('id') + '"]');
            const select = $('#' + modal.attr('data-scq-select'));
            const airlineField = $('#' + modal.attr('data-scq-airline'));
            const typeDetailField = $('#' + modal.attr('data-scq-typedetail'));

            const error = modal.find('.scq-error');
            const submit = modal.find('.scq-submit');
            const seats = modal.find('.scq-f, .scq-c, .scq-py, .scq-p, .scq-j, .scq-y');

            //詳細型式→型式名。どの型式で登録されるのかを画面に出すために使う。
            let typeNames = {};
            try {
                typeNames = JSON.parse($('.scq-typenames[data-scq-for="' + modal.attr('id') + '"]').text() || '{}');
            } catch (e) {
                typeNames = {};
            }

            //この部品はフォームの中に置かれる。中に入力欄があるとEnterでフォームが送信されてしまうので、
            //初期化のときにフォームの外（body直下）へ出しておく。
            modal.appendTo(document.body);

            const total = function () {
                let sum = 0;
                seats.each(function () {
                    const value = parseInt($(this).val(), 10);
                    if (!isNaN(value)) { sum += value; }
                });
                return sum;
            };

            seats.on('input', function () {
                const sum = total();
                modal.find('.scq-total').text(sum === 0 ? '―' : sum);
            });

            seats.add(modal.find('.scq-url')).on('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    submit.click();
                }
            });

            // ---- 開く ----
            // 航空会社と型式は編集中の内容で決まる。どちらかが未選択だと登録できない。
            opener.on('click', function () {
                const airline = airlineField.val() || '';
                const typeDetailId = typeDetailField.val() || '';
                const typeName = typeNames[typeDetailId] || '';

                const airlineText = airlineField.is('select')
                    ? (airlineField.find('option:selected').text() || '').trim()
                    : airline;

                modal.find('.scq-airline')
                    .text(airline === '' ? '未選択' : airlineText)
                    .toggleClass('empty', airline === '');
                modal.find('.scq-type')
                    .text(typeName === '' ? '未選択' : typeName)
                    .toggleClass('empty', typeName === '');

                seats.val('');
                modal.find('.scq-url').val('');
                modal.find('.scq-total').text('―');
                error.hide().text('');

                const ready = airline !== '' && typeName !== '';
                submit.prop('disabled', !ready);
                if (!ready) {
                    error.text('航空会社と詳細型式を先に選んでください。').show();
                }

                modal.modal('show');
            });

            // ---- 登録 ----
            submit.on('click', function () {
                submit.prop('disabled', true);

                $.ajax({
                    url: '/Master/CreateSeatConfig',
                    type: 'POST',
                    data: {
                        airline: airlineField.val(),
                        typeDetailId: typeDetailField.val(),
                        f: modal.find('.scq-f').val(),
                        c: modal.find('.scq-c').val(),
                        py: modal.find('.scq-py').val(),
                        p: modal.find('.scq-p').val(),
                        j: modal.find('.scq-j').val(),
                        y: modal.find('.scq-y').val(),
                        url: modal.find('.scq-url').val()
                    }
                }).done(function (data) {
                    if (data.error) {
                        error.text(data.error).show();
                        return;
                    }

                    //登録したものを選択肢にも足す。読み込み直さずそのまま選べる。
                    if (select.find('option[value="' + data.id + '"]').length === 0) {
                        select.append($('<option>').attr('value', data.id).text(data.name));
                    }
                    select.val(String(data.id)).trigger('change');

                    modal.modal('hide');
                }).fail(function (xhr) {
                    error.text('登録に失敗しました (' + xhr.status + ' ' + xhr.statusText + ')').show();
                }).always(function () {
                    submit.prop('disabled', false);
                });
            });
        });
    });
</script>
