@*
    _SeatConfigQuickAdd.cshtml を動かすスクリプト。
    site.min.js（JfUi / JfHttp / JfDom）は_Layoutの末尾で読み込まれるので、画面側の @@section ScriptsPartial の中に置くこと。
    画面内のその場登録は全部まとめて初期化するので、画面側から呼ぶものは無い。
*@
<script>
    JfDom.ready(function () {
        document.querySelectorAll('.scq-modal').forEach(function (modal) {
            const opener = document.querySelectorAll('[data-scq-open="' + modal.id + '"]');
            const select = document.getElementById(modal.getAttribute('data-scq-select'));
            const airlineField = document.getElementById(modal.getAttribute('data-scq-airline'));
            const typeDetailField = document.getElementById(modal.getAttribute('data-scq-typedetail'));

            const find = function (selector) { return modal.querySelector(selector); };
            const error = find('.scq-error');
            const submit = find('.scq-submit');
            const seats = modal.querySelectorAll('.scq-f, .scq-c, .scq-py, .scq-p, .scq-j, .scq-y');

            const showError = function (text) { error.textContent = text; JfDom.show(error); };

            //詳細型式→型式名。どの型式で登録されるのかを画面に出すために使う。
            let typeNames = {};
            try {
                const json = document.querySelector('.scq-typenames[data-scq-for="' + modal.id + '"]');
                typeNames = JSON.parse((json && json.textContent) || '{}');
            } catch (e) {
                typeNames = {};
            }

            //この部品はフォームの中に置かれる。中に入力欄があるとEnterでフォームが送信されてしまうので、
            //初期化のときにフォームの外（body直下）へ出しておく。
            document.body.appendChild(modal);

            const total = function () {
                let sum = 0;
                seats.forEach(function (input) {
                    const value = parseInt(input.value, 10);
                    if (!isNaN(value)) { sum += value; }
                });
                return sum;
            };

            seats.forEach(function (input) {
                input.addEventListener('input', function () {
                    const sum = total();
                    find('.scq-total').textContent = sum === 0 ? '―' : sum;
                });
            });

            Array.prototype.concat.call(Array.from(seats), [find('.scq-url')]).forEach(function (input) {
                input.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        submit.click();
                    }
                });
            });

            // ---- 開く ----
            // 航空会社と型式は編集中の内容で決まる。どちらかが未選択だと登録できない。
            opener.forEach(function (button) {
                button.addEventListener('click', function () {
                    const airline = airlineField.value || '';
                    const typeDetailId = typeDetailField.value || '';
                    const typeName = typeNames[typeDetailId] || '';

                    const airlineText = airlineField.tagName === 'SELECT'
                        ? ((airlineField.selectedOptions[0] && airlineField.selectedOptions[0].text) || '').trim()
                        : airline;

                    const airlineLabel = find('.scq-airline');
                    airlineLabel.textContent = airline === '' ? '未選択' : airlineText;
                    airlineLabel.classList.toggle('empty', airline === '');
                    const typeLabel = find('.scq-type');
                    typeLabel.textContent = typeName === '' ? '未選択' : typeName;
                    typeLabel.classList.toggle('empty', typeName === '');

                    seats.forEach(function (input) { input.value = ''; });
                    find('.scq-url').value = '';
                    find('.scq-total').textContent = '―';
                    JfDom.hide(error);
                    error.textContent = '';

                    const ready = airline !== '' && typeName !== '';
                    submit.disabled = !ready;
                    if (!ready) {
                        showError('航空会社と詳細型式を先に選んでください。');
                    }

                    JfUi.modal.show(modal);
                });
            });

            // ---- 登録 ----
            submit.addEventListener('click', function () {
                submit.disabled = true;

                JfHttp.post('/Master/CreateSeatConfig', {
                    airline: airlineField.value,
                    typeDetailId: typeDetailField.value,
                    f: find('.scq-f').value,
                    c: find('.scq-c').value,
                    py: find('.scq-py').value,
                    p: find('.scq-p').value,
                    j: find('.scq-j').value,
                    y: find('.scq-y').value,
                    url: find('.scq-url').value
                }).then(function (data) {
                    if (data.error) {
                        showError(data.error);
                        return;
                    }

                    //登録したものを選択肢にも足す。読み込み直さずそのまま選べる。
                    const id = String(data.id);
                    if (!Array.from(select.options).some(function (o) { return o.value === id; })) {
                        select.add(new Option(data.name, id));
                    }
                    select.value = id;
                    JfDom.trigger(select, 'change');

                    JfUi.modal.hide(modal);
                }, function (xhr) {
                    showError('登録に失敗しました (' + xhr.status + ' ' + xhr.statusText + ')');
                }).then(function () {
                    submit.disabled = false;
                });
            });
        });
    });
</script>
